				ruleset_n: length(rf('/tmp/kelclash/config.yaml') ? filter(split(rf('/tmp/kelclash/config.yaml'), '\n'), (l) => index(l, '  rs_') === 0) : []),
				ruleset_at: +(trim(rf('/tmp/kelclash/rules.ts') ?? '') || 0)
			};
