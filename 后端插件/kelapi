	get_pppd_error_code: {
		call: function () {
			let proto = t(uget('network', 'wan', 'proto', 'dhcp'));
			if (proto !== 'pppoe') return { error_code: '0' };
			let st = ifstatus('wan');
			if (st && st.up) return { error_code: '0' };
			let log = sh("logread -e pppd 2>/dev/null; logread -e pppoe 2>/dev/null");
			if (index(log, 'Authentication failed') >= 0) return { error_code: '11' };
			if (index(log, 'Login failed') >= 0) return { error_code: '11' };
			if (index(log, 'CHAP authentication failed') >= 0) return { error_code: '11' };
			if (index(log, 'PAP authentication failed') >= 0) return { error_code: '11' };
			if (index(log, 'LERNE') >= 0) return { error_code: '11' };
			return { error_code: '0' };
		}
