	get_wan_info: {
		call: function () {
			let c = cfg('network');
			let proto = t(c.get('network', 'wan', 'proto'));
			if (proto === '') proto = 'dhcp';
			/* 无线中继启用时上网方式要报 wds（前端 case"wds" 显示“无线中继”并回填配置） */
			if (relayIsUplink()) proto = 'wds';
			let st = ifstatus('wan');
			let v4 = firstAddr(st, 'ipv4');
			let dns = [];
			if (st && st['dns-server']) for (let d in st['dns-server']) push(dns, '' + d);
			let info = {
				ipaddr: '', netmask: '', gateway: '',
				dns1: '', dns2: '', dns_enabled: 0, mtu: 1500
			};
			if (v4) {
				info.ipaddr = v4.address;
				info.netmask = prefixToMask(v4.mask);
			}
			if (st && st.route) {
				for (let r in st.route) {
					if (r && r.target === '0.0.0.0') info.gateway = r.nexthop ?? '';
				}
			}
			info.dns1 = dns[0] ?? '';
			info.dns2 = dns[1] ?? '';
			if (st && st.mtu) info.mtu = st.mtu;
			/* v15: 读侧闭环 —— 运行态拿不到时回退 uci 持久配置。
			   断网/未拨号期 ifstatus 空 → 旧实现页面读回空值,
			   下次保存把空值写回, 配置保存即丢(第二阶段)。 */
			info.dns_enabled = (t(c.get('network', 'wan', 'peerdns')) === '0') ? 1 : 0;
			if (info.dns_enabled === 1 && (info.dns1 === '' || info.dns2 === '')) {
				let ud = c.get('network', 'wan', 'dns');
				let arr = (type(ud) === 'array') ? ud : ((ud != null && t(ud) !== '') ? [ '' + ud ] : []);
				if (info.dns1 === '') info.dns1 = t(arr[0] ?? '');
				if (info.dns2 === '') info.dns2 = t(arr[1] ?? '');
			}
			if (!(st && st.mtu)) {
				let um = t(c.get('network', 'wan', 'mtu'));
				if (um !== '') info.mtu = num(um, 1500);
			}

			let dev = t(c.get('network', 'wan', 'device'));
			if (dev === '') dev = 'wan';
			let mac = t(c.get('network', 'wan', 'macaddr'));
			if (mac === '') mac = macOf(dev);
			let out = { macaddr: lc(mac), proto: proto };
			if (proto === 'wds') {
				/* wds_info：wwan（中继上行）的真实联网信息 */
				let ws = ifstatus('wwan');
				let w4 = firstAddr(ws, 'ipv4');
				let wd = [];
				if (ws && ws['dns-server']) for (let d in ws['dns-server']) push(wd, '' + d);
				let winfo = { ipaddr: '', netmask: '', gateway: '', dns1: '', dns2: '', dns_enabled: 0, mtu: 1500 };
				if (w4) {
					winfo.ipaddr = w4.address;
					winfo.netmask = prefixToMask(w4.mask);
				}
				if (ws && ws.route) {
					for (let r in ws.route) {
						if (r && r.target === '0.0.0.0') winfo.gateway = r.nexthop ?? '';
					}
				}
				winfo.dns1 = wd[0] ?? '';
				winfo.dns2 = wd[1] ?? '';
				if (ws && ws.mtu) winfo.mtu = ws.mtu;
				out.wds_info = winfo;
				out.dhcp_info = info;
			} else if (proto === 'pppoe') {
				info.username = t(c.get('network', 'wan', 'username'));
				info.password = t(c.get('network', 'wan', 'password'));
				out.pppoe_info = info;
			} else if (proto === 'static') {
				if (info.ipaddr === '') info.ipaddr = bareIP(t(c.get('network', 'wan', 'ipaddr')));
				if (info.netmask === '') info.netmask = t(c.get('network', 'wan', 'netmask'));
				if (info.gateway === '') info.gateway = t(c.get('network', 'wan', 'gateway'));
				out.static_info = info;
			} else {
				out.dhcp_info = info;
			}
			return out;
		}
	},

