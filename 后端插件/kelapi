/* ⚠️ rpcd 会把插件里抛出的异常**吞掉**，只回一个裸的 UBUS_STATUS_UNKNOWN_ERROR(9)。
 *   前端看到的只是「操作失败」，logread 里一行堆栈都没有 —— 根本没法查。
 *   （真实事故：applyWifi 被放在 wifiSection 之前，而 ucode 不做函数提升，
 *     set_wifi 恒返回 [9]，靠把异常写进返回值才定位到。）
 *   所以这里给**每个**方法统一套一层，把真实原因带回去。
 *   同时保留原有的「写方法不许空参数」守卫。 */
for (let _n in keys(methods)) {
	let _def = methods[_n];
	if (type(_def) != 'object' || type(_def.call) != 'function') continue;
	let _orig = _def.call;
	let _ro = (READ_ONLY[_n] != null);
	let _allowEmpty = (ALLOW_EMPTY_ARGS[_n] != null);
	/* 留一份**未包装**的原函数。包装层把异常变成返回值之后，
	   真正抛在哪一行就看不到了；在路由器上用 ucode 命令行 loadfile 本文件后直接调 .raw
	   就能拿到 ucode 原生的 file:line 报错。生产路径不受影响。 */
	_def.raw = _orig;
	_def.call = function (req) {
		let _a = (req != null) ? req.args : null;
		if (!_ro && !_allowEmpty) {
			if (type(_a) != 'object' || length(keys(_a)) == 0)
				return { status: 1, error: 'missing arguments' };
		}
		try {
			return _orig(req);
		} catch (e) {
			/* ucode 的 throw 既能抛对象（带 .message）也能抛字符串，两种都要认，
			   而且不能只手滑去读字符串的 .message —— 那会在 catch 里再抛一次，
			   白套这层保护。 */
			let _m = '';
			if (e != null && type(e) == 'object' && e.message != null) _m = '' + e.message;
			else _m = '' + e;
			return { status: 9, error: _m };
		}
	};
}

