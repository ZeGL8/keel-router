	[ /^(android|galaxy|sm-[a-z0-9]+|xiaomi|redmi|poco|huawei|honor|oppo|vivo|oneplus|realme|iqoo|pixel)/i, 'phone' ],
	[ /(desktop|laptop|^pc-|-pc$|thinkpad|surface|^win(dows)?-|^dell|^lenovo|^hp-)/i, 'pc' ],
	[ /(^esp[-_]|espressif|^tuya|smartlife|^lumi|^miio|yeelink|zhimi|chuangmi|viomi|roborock|dreame|ecovacs|midea|^gree|haier)/i, 'iot' ],
	[ /(bravia|roku|firetv|chromecast|hisense|^tcl|skyworth|konka|mibox|mitv|android-?tv|^tv-|-tv$)/i, 'tv' ],
	[ /(printer|epson|canon|brother|laserjet|officejet)/i, 'printer' ],
	[ /(camera|hikvision|dahua|^ipc|ezviz|wyze|tapo|imou)/i, 'camera' ],
	[ /(xbox|playstation|^ps[45]|nintendo)/i, 'game' ],
	[ /(^echo|alexa|homepod|sonos|nest-?mini|xiaoai|tmall)/i, 'speaker' ],
	[ /(synology|diskstation|qnap|^nas)/i, 'nas' ]
