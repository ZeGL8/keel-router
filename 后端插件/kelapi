				ua: subUa(c), ua_default: SUB_UA_DEFAULT,
				mode: t(c.get('kelclash', 'main', 'mode')) || 'rule',
				version: t(c.get('kelclash', 'main', 'version')),
				core: st?.core ?? 'stopped',
				rules: st?.rules ?? 0,
				binary: st?.binary ?? 0,
				downloaded: dl,
				transparent: t(c.get('kelclash', 'main', 'transparent')) === '1' ? '1' : '0',
				scope: (length(only) > 0) ? 'some' : 'all',
				auto_switch: (t(c.get('kelclash', 'main', 'auto_switch')) === '0') ? '0' : '1',
				ipv6: (t(c.get('kelclash', 'main', 'ipv6')) === 'direct') ? 'direct' : 'proxy',
				quic: (t(c.get('kelclash', 'main', 'quic')) === 'allow') ? 'allow' : 'block',
				quic_on: st?.quic ?? 0,
