	   首页现在的「存储状态」卡（内存/闪存）走 web_get_storage_info。
	   历史坑（勿重蹈）：web_storage_exter_get_all 若返回的 status 与前端首查不同，
	   routerStatus 的 x() 会 `window.location.reload()` → 无限刷新。 */

	mwan_get_info: { call: function () { return { mwan_info: [], mwan_status: 0 }; } },
	mwan_get_interface_info: { call: function () { return { data: [] }; } },
	mwan_get_interface_status: { call: function () { return { data: [] }; } },
	mwan_set_interface_info: {
		/* 有线模式保存（动态IP/静态/宽带）。旧实现是空壳：回 status 0 但什么都不写，
		   从「无线中继」切走时页面报成功、中继却还开着。真实现：
		   ① 切走时先关 wwan；② 按 proto 写 network.wan；③ 按 dns_enabled 写 DNS。 */
		call: function (req) {
			let a = req.args ?? {};
			let proto = t(a.proto);
			if (proto !== 'dhcp' && proto !== 'static' && proto !== 'pppoe')
				return { status: 1, error: 'bad proto' };
			relayDisable();
			let c = cfg('network');
			c.set('network', 'wan', 'proto', proto);
			let clr = [ 'username', 'password', 'ipaddr', 'netmask', 'gateway', 'mtu' ];
			for (let o in clr) { try { c.delete('network', 'wan', o); } catch (e) {} }
			if (proto === 'static') {
				if (a.ipaddr && isIPv4(t(a.ipaddr))) c.set('network', 'wan', 'ipaddr', t(a.ipaddr));
				if (a.netmask && isIPv4(t(a.netmask))) c.set('network', 'wan', 'netmask', t(a.netmask));
				if (a.gateway && isIPv4(t(a.gateway))) c.set('network', 'wan', 'gateway', t(a.gateway));
			} else if (proto === 'pppoe') {
				if (a.username != null) c.set('network', 'wan', 'username', t(a.username));
				if (a.password != null) c.set('network', 'wan', 'password', t(a.password));
				let mtu = num(a.mtu, 1492);
				if (mtu == null) mtu = 1492;
				c.set('network', 'wan', 'mtu', '' + mtu);
			}
			wanPhysMtu(c, proto === 'pppoe');
			wan6Bind(c);
			c.commit('network');
			/* DNS 是 list 选项，走 uci CLI（cursor 对 list 不可靠，见文件上方 t() 的注释） */
			if (t(a.dns_enabled) === '1' && (isIPv4(t(a.dns1)) || isIPv4(t(a.dns2)))) {
				sh('uci -q delete network.wan.dns');
				if (isIPv4(t(a.dns1))) sh('uci add_list network.wan.dns=' + "'" + t(a.dns1) + "'");
				if (isIPv4(t(a.dns2))) sh('uci add_list network.wan.dns=' + "'" + t(a.dns2) + "'");
				sh("uci -q set network.wan.peerdns='0'");
			} else {
				sh('uci -q delete network.wan.dns');
				sh("uci -q set network.wan.peerdns='1'");
			}
			sh('uci commit network');
			netReload();
			return { status: 0 };
		}
	},
