				let q = function (path) {
					let r = sh("curl -s -m4 -H 'Authorization: Bearer " + secret + "' http://127.0.0.1:9090" + path);
					try { return json(r); } catch (e) { return null; }
				};
				/* /proxies 只有「组」；具体节点（名字、类型、延迟历史）在订阅 provider 里 */
				let grp = q('/proxies/%E4%BB%A3%E7%90%86');
				let pv = q('/providers/proxies/sub');
				if (grp != null) {
					out.selected = grp.now ?? '';
					let auto = q('/proxies/%E8%87%AA%E5%8A%A8%E9%80%89%E6%8B%A9');
					out.auto_now = auto?.now ?? '';
					/* 智能回退是懒检测组：只有「代理」组选中了它，它的 now 才是真实的 */
					if (out.selected === '智能回退') out.fb_now = q('/proxies/%E6%99%BA%E8%83%BD%E5%9B%9E%E9%80%80')?.now ?? '';
				}
				let anySvc = false;
