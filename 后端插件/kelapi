	if (length(ks) > 400) ks = slice(ks, 0, 400);
	for (let k in ks) {
		let p = _devProf[k];
		push(out, join('|', [k, replace('' + p.name, '|', '/'), p.kind ?? '', replace('' + (p.model ?? ''), '|', '/'), p.src ?? '', '' + (p.ts ?? 0)]));
