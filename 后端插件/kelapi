			if (v6 !== '') c.set('kelclash', 'main', 'ipv6', v6);		/* 接管规则由守护按 uci 收敛，不需要重启 */
			if (qc !== '') c.set('kelclash', 'main', 'quic', qc);
			for (let k in SVC_KEYS) if (svcNew[k] !== '' && svcNew[k] !== svcOld[k]) { c.set('kelclash', 'main', 'svc_' + k, svcNew[k]); svcChanged = true; }
			if (url !== old || uaChanged) sh('rm -f /etc/kelclash/sub.last.gz /tmp/kelclash/sub.yaml /tmp/kelclash/sub.md5');	/* 换订阅：旧缓存作废 */
			c.commit('kelclash');
			sh('/etc/init.d/kelclash ' + (en === '1' ? 'enable' : 'disable') + ' >/dev/null 2>&1');
			/* 只有「内核层面」的改动才重启：开关、订阅、模式、自定义规则。
			   切「接管全家/仅本设备」只是改 uci，guard 每 5 秒读一次，立即生效、不重启 */
			let rulesNow = newRules ?? oldRules;
			if (en !== oldEn || url !== old || uaChanged || t(a.restart) === '1')
				sh('/etc/init.d/kelclash restart >/dev/null 2>&1');
			else if (mode !== oldMode && rulesNow === oldRules && !svcChanged && st0 === 'running'
				&& trim(sh('/usr/share/kelclash/run.sh mode >/dev/null 2>&1; echo $?')) === '0') {
				/* 只改了模式：mihomo 的 PATCH 即时生效（<1 秒），并关掉已有连接让设备跟着变——不需要热重载。
				   （全局组 GLOBAL 一直都在配置里，切模式本来就不用重载；以前这里走热重载要 10–40 秒，期间页面「应用中」、设备反应慢）
				   PATCH 没成功时落到下面的热重载，行为和以前一样。 */
			}
			else if (mode !== oldMode || rulesNow !== oldRules || svcChanged) {
				/* 热重载（不重启、不断连接）要 10–40 秒，放后台做（run.sh apply-bg），本接口立刻返回 applying=1；
				   页面轮询 web_get_clash 的 apply 字段看结果。内核拒绝新配置时由 apply-bg 按快照回滚并记事件。
				   快照 = 最近一次「确认生效」的设置：已有快照说明上一次还没应用完，不能用这次的「旧值」（其实是未生效的值）覆盖它。 */
				if (st0 === 'running') {
					if (!access('/tmp/kelclash/apply.bak')) {
						let snap = 'mode\t' + oldMode + '\n';
						for (let k in SVC_KEYS) snap += 'svc_' + k + '\t' + svcOld[k] + '\n';
						wf('/tmp/kelclash/apply.rules', oldRules);
						wf('/tmp/kelclash/apply.bak', snap);
					}
					wf('/tmp/kelclash/apply.state', 'running\n');
					sh('/usr/share/kelclash/run.sh apply-bg >/dev/null 2>&1 &');
					return { status: 0, only_mac: onlyMacs ?? [], applying: 1 };
				}
			}
			return { status: 0, only_mac: onlyMacs ?? [] };
		}
	},

	/* 切模式：{ mode } —— 写 uci 后热重载（不重启、不断连接）；内核没接受就回滚。返回码：2 参数错 / 3 内核拒绝（已回滚） */
	web_clash_mode: {
		call: function (req) {
			let mode = t(req.args?.mode);
			if (index(['rule', 'global', 'direct'], mode) < 0) return { status: 2 };
			let c = cfg('kelclash');
			let old = t(c.get('kelclash', 'main', 'mode'));
			if (mode === old) return { status: 0 };
			c.set('kelclash', 'main', 'mode', mode);
			c.commit('kelclash');
			if (trim(sh('/usr/share/kelclash/run.sh mode >/dev/null 2>&1; echo $?')) !== '0') {
				c.set('kelclash', 'main', 'mode', old);
				c.commit('kelclash');
				sh('/usr/share/kelclash/run.sh reconfig >/dev/null 2>&1');
				return { status: 3 };
			}
			return { status: 0 };
		}
	},

	/* 代理流量统计：{ range:'today'|'month'|'all' } —— 走了代理（出口不是直连）的流量，按天、按设备累计。
	   数据来自采集器 stats.uc（守护拉起）写的 /tmp/kelclash/stats.json（内存，30 秒一更）；重启后内存里没有就读闪存里的那份（30 分钟一存）。
	   days：最近 30 天（升序，没数据的天补 0，页面画柱状图用）；sum：所选范围的合计（pu/pd = 代理 上传/下载，du/dd = 直连）；
	   devices：所选范围里代理流量最多的设备（最多 12 个）。 */
	web_get_clash_stats: {
		call: function (req) {
			let rng = t(req.args?.range);
			if (rng !== 'month' && rng !== 'all') rng = 'today';
			let j = null;
			for (let p in ['/tmp/kelclash/stats.json', '/etc/kelclash/stats.json']) {
				try { let x = json(rf(p)); if (x?.v === 1 && type(x.days) == 'object') { j = x; break; } } catch (e) {}
			}
			let empty = { status: 0, empty: 1, days: [], devices: [], sum: { pu: 0, pd: 0, du: 0, dd: 0 }, total: { pu: 0, pd: 0 } };
			if (j == null) return empty;
			let key = function (ts) { let lt = localtime(ts); return sprintf('%04d%02d%02d', lt.year, lt.mon, lt.mday); };
			let now = time(), today = key(now), month = substr(today, 0, 6);
			let days = [];
			for (let i = 29; i >= 0; i--) {
				let k = key(now - i * 86400), d = j.days[k];
				push(days, { d: k, pu: d?.pu ?? 0, pd: d?.pd ?? 0, du: d?.du ?? 0, dd: d?.dd ?? 0 });
			}
			let sum = { pu: 0, pd: 0, du: 0, dd: 0 }, dev = {};
			for (let k in keys(j.days)) {
				if (k === 'pending') continue;
				if (rng === 'today' && k !== today) continue;
				if (rng === 'month' && substr(k, 0, 6) !== month) continue;
				let d = j.days[k];
				sum.pu += d.pu; sum.pd += d.pd; sum.du += d.du; sum.dd += d.dd;
				for (let m in keys(d.dev ?? {})) {
					let e = dev[m] ?? [0, 0];
					dev[m] = [e[0] + d.dev[m][0], e[1] + d.dev[m][1]];
				}
			}
			let rows = [], lt = dhcpLeases();
			for (let m in keys(dev)) {
				let nm = m;
				if (m === 'other') nm = '其他（未能归到具体设备）';
				else if (m === 'unknown') nm = '未知设备';
				else if (isMAC(m)) nm = devDisplayName(m, t(lt[lc(m)]?.name ?? lt[uc(m)]?.name)) || m;
				push(rows, { id: m, name: nm, up: dev[m][0], down: dev[m][1] });
			}
			sort(rows, (a, b) => (b.up + b.down) - (a.up + a.down));
			return { status: 0, empty: 0, range: rng, days: days, sum: sum, devices: slice(rows, 0, 12), total: j.total ?? { pu: 0, pd: 0 } };
		}
	},

	/* 实时数据：{ list:'1' } —— 累计上传/下载、活动连接数、内核内存；list=1 时附带连接明细（按流量排序，最多 200 条）。
	   速度由页面用相邻两次的累计差值算（mihomo 的 /traffic 是流式接口，取一行要等 3 秒，不适合轮询）。 */
	web_clash_live: {
		call: function (req) {
			let sec = mihomoSecret();
			if (sec == null) return { status: 1 };
			let cj = mihomoGet(sec, '/connections', 5);
			if (cj == null) return { status: 1 };
			let all = cj.connections ?? [];
			let out = { status: 0, up_total: cj.uploadTotal ?? 0, down_total: cj.downloadTotal ?? 0, mem: 0, count: length(all) };
			/* 内核内存：读进程 VmRSS（/connections 里的 memory 字段没订阅者时恒为 0） */
			let pid = trim(rf('/tmp/kelclash/pid') ?? '');
			if (match(pid, /^[0-9]+$/) != null) {
				let mm = match(rf('/proc/' + pid + '/status') ?? '', /VmRSS:[ \t]*([0-9]+) kB/);
				if (mm != null) out.mem = +mm[1] * 1024;
			}
			if (t(req.args?.list) === '1') {
				let devs = {};
				let ls = dhcpLeases();
				for (let m in keys(ls)) if (t(ls[m].ip) !== '') devs[ls[m].ip] = devDisplayName(m, t(ls[m].name));
				let rows = [];
				for (let c in all) {
					let md = c.metadata ?? {};
					let ch = c.chains ?? [];
					let host = t(md.host) || t(md.sniffHost) || t(md.destinationIP);
					push(rows, {
						id: c.id ?? '', host: host, dst: (t(md.destinationIP) !== '') ? t(md.destinationIP) + ':' + t(md.destinationPort) : '端口 ' + t(md.destinationPort),	/* 按域名发起的连接没有目的 IP（域名已在上一行），以前显示成孤零零的「:443」 */
						src: t(md.sourceIP), net: t(md.network), rule: t(c.rule) + ((t(c.rulePayload) !== '') ? '(' + t(c.rulePayload) + ')' : ''),
						node: (length(ch) > 0) ? ch[0] : 'DIRECT', up: c.upload ?? 0, down: c.download ?? 0, start: c.start ?? ''
					});
				}
				sort(rows, function (a, b) { return ((b.up + b.down) - (a.up + a.down)); });
				out.conns = slice(rows, 0, 200);
				out.devices = devs;
			}
			return out;
		}
	},

	/* 守护事件：谁在什么时候接管/撤销/重启了什么（run.sh 的 ev()，最多 60 条，最新在后） */
	web_clash_events: {
		call: function () {
			return { status: 0, events: readEvents('/tmp/kelclash/events'), health: trim(rf('/tmp/kelclash/health') ?? '') };
		}
	},

	/* 最近的内核日志（core.log 末尾 300 行，info 级：含每条连接的走向） */
	web_clash_logs: {
		call: function () {
			let raw = sh('tail -n 300 /tmp/kelclash/core.log 2>/dev/null');
			let lines = [];
			for (let ln in split(raw, '\n')) {
				if (trim(ln) === '') continue;
				let m = match(ln, /^time="([^"]*)" level=([a-z]+) msg="(.*)"$/);
				if (m != null) {
					let msg = replace(replace(m[3], '\\"', '"'), '\\\\', '\\');
					push(lines, { t: m[1], l: m[2], m: msg });
				} else push(lines, { t: '', l: 'info', m: ln });
			}
			return { status: 0, lines: lines };
		}
	},

	/* 当前生效的规则（含命中次数）——默认分流规则 + 自定义规则 */
	web_clash_rules: {
		call: function () {
			let sec = mihomoSecret();
			if (sec == null) return { status: 1 };
			let rj = mihomoGet(sec, '/rules', 5);
			if (rj == null) return { status: 1 };
			let out = [];
			for (let r in (rj.rules ?? [])) {
				push(out, { type: t(r.type), payload: t(r.payload), proxy: t(r.proxy), hits: r.extra?.hitCount ?? 0 });
				if (length(out) >= 300) break;
			}
			return { status: 0, rules: out };
		}
	},

	/* 断开连接：{ id: '<uuid>' | 'all' }。返回码：1 未运行 / 2 参数错 / 4 失败 */
	web_clash_conn_close: {
		call: function (req) {
			let id = t(req.args?.id);
			let sec = mihomoSecret();
			if (sec == null) return { status: 1 };
			if (id !== 'all' && match(id, /^[0-9a-fA-F-]{8,64}$/) == null) return { status: 2 };
			mihomoCurl(sec, 'DELETE', (id === 'all') ? '/connections' : '/connections/' + id, 4);
			return { status: 0 };
		}
	},

	/* 单个节点测速：{ name } → { delay }（超时/不通 status 3）。返回码：1 未运行 / 2 参数错 */
	web_clash_delay: {
		call: function (req) {
			let name = t(req.args?.name);
			let sec = mihomoSecret();
			if (sec == null) return { status: 1 };
			if (name === '' || length(name) > 200) return { status: 2 };
			/* 订阅节点的单点测速在 provider 下（/proxies/{名}/delay 对 provider 节点是 404）；结果会写进延迟历史，节点页随后能看到 */
			let r = mihomoGet(sec, '/providers/proxies/sub/' + urlEnc(name) + '/healthcheck?url=https%3A%2F%2Fwww.gstatic.com%2Fgenerate_204&timeout=5000', 8);
			if (r == null || r.delay == null) return { status: 3 };
			return { status: 0, delay: r.delay };
		}
	},

	/* ================= 广告过滤（AdGuardHome）================= */

	/* 总状态：开关/引擎/转发规则/健康 + 拦截统计 + 订阅列表 + 自定义规则。引擎没运行时只回基础字段。返回码：1 未安装 */
	web_get_adg: {
		call: function () {
			if (!access('/etc/init.d/keladg')) return { status: 1 };
			let c = cfg('keladg'), st = adgStatus();
			let out = {
				status: 0,
				enabled: t(c.get('keladg', 'main', 'enabled')) === '1' ? '1' : '0',
				force_dns: t(c.get('keladg', 'main', 'force_dns')) === '1' ? '1' : '0',
				version: t(c.get('keladg', 'main', 'version')),
				core: st.core ?? 'stopped', rules: st.rules ?? 0, binary: st.binary ?? 0, guard: st.guard ?? 0,
				phase: trim(split(rf('/tmp/keladg/phase') ?? '', '\n')[0] ?? ''),
				phase_msg: trim(split(rf('/tmp/keladg/phase') ?? '', '\n')[1] ?? ''),
				health: trim(rf('/tmp/keladg/health') ?? ''),
				lan_ip: lanAddr().ip, now: time(),
				/* 规则列表后台任务的状态：''|running|操作 / ok|操作 / fail|操作|原因 */
				fjob: trim(rf('/tmp/keladg/fjob.state') ?? ''),
				protection: 1, stats: null, filters: [], user_rules: '', filters_updated: 0
			};
			if (out.core !== 'running') return out;
			let s = adgCall('GET', '/control/status', null, 4);
			if (s.code === 200 && s.data != null) out.protection = s.data.protection_enabled ? 1 : 0;
			let nm = ipNameMap();
			let sr = adgCall('GET', '/control/stats', null, 5);
			if (sr.code === 200 && sr.data != null) {
				let d = sr.data;
				let blocked = (d.num_blocked_filtering ?? 0) + (d.num_replaced_safebrowsing ?? 0) + (d.num_replaced_parental ?? 0);
				let total = d.num_dns_queries ?? 0;
				out.stats = {
					queries: total, blocked: blocked,
					ratio: (total > 0) ? sprintf('%.1f', blocked * 100.0 / total) : '0.0',
					avg_ms: sprintf('%.0f', (d.avg_processing_time ?? 0) * 1000),
					top_blocked: adgTop(d.top_blocked_domains, null),
					top_queried: adgTop(d.top_queried_domains, null),
					top_clients: adgTop(d.top_clients, nm),
					hourly: d.dns_queries ?? [], hourly_blocked: d.blocked_filtering ?? []
				};
			}
			let f = adgCall('GET', '/control/filtering/status', null, 5);
			if (f.code === 200 && f.data != null) {
				for (let x in (f.data.filters ?? [])) push(out.filters, { id: x.id, name: x.name, url: x.url, enabled: x.enabled ? 1 : 0, rules: x.rules_count ?? 0, updated: t(x.last_updated) });
				out.user_rules = join('\n', f.data.user_rules ?? []);
				out.filters_updated = f.data.interval ?? 0;
			}
			return out;
		}
	},

	/* 开关等设置：{ enabled, force_dns, protection, restart }（都可不带）。
	   enabled：开/关广告过滤（引擎每次开机在内存里重建，首次要下载约 11MB）；force_dns：设备自己配了别的 DNS 也拉回来过滤；
	   protection：临时暂停/恢复过滤（引擎保持运行）。返回码：1 未安装 / 2 参数错 / 3 引擎没在运行 / 4 引擎拒绝 */
	web_set_adg: {
		call: function (req) {
			if (!access('/etc/init.d/keladg')) return { status: 1 };
			let a = req.args ?? {};
			let en = t(a.enabled), fd = t(a.force_dns), pr = t(a.protection);
			for (let v in [en, fd, pr]) if (v !== '' && v !== '0' && v !== '1') return { status: 2 };
			let c = cfg('keladg');
			let oldEn = t(c.get('keladg', 'main', 'enabled'));
			sh("logger -t kelapi 'web_set_adg enabled=" + en + " force_dns=" + fd + " protection=" + pr + "'");
			if (pr !== '') {
				if (adgStatus().core !== 'running') return { status: 3 };
				let r = adgCall('POST', '/control/protection', { enabled: (pr === '1') }, 6);
				if (r.code !== 200) return { status: 4 };
			}
			if (fd !== '') c.set('keladg', 'main', 'force_dns', fd);
			if (en !== '') c.set('keladg', 'main', 'enabled', en);
			c.commit('keladg');
			if (en !== '') sh('/etc/init.d/keladg ' + (en === '1' ? 'enable' : 'disable') + ' >/dev/null 2>&1');
			if ((en !== '' && en !== oldEn) || t(a.restart) === '1') sh('/etc/init.d/keladg restart >/dev/null 2>&1');
			return { status: 0 };
		}
	},

	/* 订阅（过滤规则列表）管理：{ op:'add'|'remove'|'toggle'|'refresh', url, name }。
	   add / toggle / refresh 在后台做（见 adgJob），返回 pending=1，结果看 web_get_adg 的 fjob；remove 很快，同步做。
	   返回码：1 引擎没在运行 / 2 参数错 / 4 引擎拒绝（error 里有原因）/ 5 该订阅已存在 / 6 上一个操作还没做完 */
	web_adg_filter: {
		call: function (req) {
			if (adgStatus().core !== 'running') return { status: 1 };
			let a = req.args ?? {};
			let op = t(a.op), url = trim(t(a.url)), name = trim(t(a.name));
			if (index(['add', 'remove', 'toggle', 'refresh'], op) < 0) return { status: 2 };
			if (op !== 'refresh' && (!match(url, /^https?:\/\/[^[:space:]"'`$\\]+$/) || length(url) > 1024)) return { status: 2 };
			if (length(name) > 80 || adgBadText(name)) return { status: 2 };
			if (op === 'refresh') {
				return adgJob('refresh', '/control/filtering/refresh', { whitelist: false }, 120);
			}
			if (op === 'add') {
				if (name === '') name = replace(replace(url, /^https?:\/\//, ''), /[\/?#].*$/, '');
				let f0 = adgCall('GET', '/control/filtering/status', null, 5);
				for (let x in (f0.data?.filters ?? [])) if (x.url === url) return { status: 5 };
				return adgJob('add', '/control/filtering/add_url', { name: name, url: url, whitelist: false }, 90);
			}
			if (op === 'remove') {
				let r = adgCall('POST', '/control/filtering/remove_url', { url: url, whitelist: false }, 15);
				return (r.code === 200) ? { status: 0 } : { status: 4, error: trim(r.raw) };
			}
			/* toggle：取出当前名字和状态，翻转启用位 */
			let f = adgCall('GET', '/control/filtering/status', null, 5);
			if (f.code !== 200 || f.data == null) return { status: 4 };
			for (let x in (f.data.filters ?? [])) if (x.url === url) {
				let r = adgJob('toggle', '/control/filtering/set_url', { url: url, whitelist: false, data: { name: x.name, url: x.url, enabled: !x.enabled } }, 90);
				r.enabled = x.enabled ? 0 : 1;
				return r;
			}
			return { status: 2 };
		}
	},

	/* 自定义规则整体保存：{ rules_text }（每行一条 AdGuard 规则，# 或 ! 开头是注释）。返回码：1 引擎没在运行 / 2 格式不对 / 4 引擎拒绝 */
	web_adg_rules: {
		call: function (req) {
			if (adgStatus().core !== 'running') return { status: 1 };
			let lines = [];
			for (let ln in split(t(req.args?.rules_text), '\n')) {
				ln = trim(ln);
				if (ln === '') continue;
				if (length(ln) > 512 || adgBadText(ln)) return { status: 2, line: ln };
				push(lines, ln);
			}
			if (length(lines) > 2000) return { status: 2 };
			let r = adgCall('POST', '/control/filtering/set_rules', { rules: lines }, 15);
			return (r.code === 200) ? { status: 0, count: length(lines) } : { status: 4, error: trim(r.raw) };
		}
	},

	/* 「这个网站被误拦了 / 我想拦这个网站」：{ domain, mode:'allow'|'block'|'reset' }。
	   allow 加 @@||域名^（放行，含子域名），block 加 ||域名^，reset 清掉我们加过的这两种规则。返回码：1 引擎没在运行 / 2 域名不合法 / 4 引擎拒绝 */
	web_adg_allow: {
		call: function (req) {
			if (adgStatus().core !== 'running') return { status: 1 };
			let d = lc(trim(t(req.args?.domain))), mode = t(req.args?.mode);
			if (!match(d, /^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$/) || index(d, '.') < 0) return { status: 2 };
			if (index(['allow', 'block', 'reset'], mode) < 0) return { status: 2 };
			let cur = adgUserRules();
			if (cur == null) return { status: 4 };
			let keep = [];
			for (let ln in cur) if (ln !== '@@||' + d + '^' && ln !== '||' + d + '^') push(keep, ln);
			if (mode === 'allow') push(keep, '@@||' + d + '^');
			if (mode === 'block') push(keep, '||' + d + '^');
			let r = adgCall('POST', '/control/filtering/set_rules', { rules: keep }, 15);
			return (r.code === 200) ? { status: 0 } : { status: 4, error: trim(r.raw) };
		}
	},

	/* 查询记录：{ search, only_blocked:'0'|'1', limit } —— 每条带设备名、是否被拦、命中的规则。返回码：1 引擎没在运行 */
	web_adg_querylog: {
		call: function (req) {
			if (adgStatus().core !== 'running') return { status: 1 };
			let a = req.args ?? {};
			let lim = int(t(a.limit)); if (lim < 1 || lim > 500) lim = 100;
			let q = '/control/querylog?limit=' + lim;
			let sv = trim(t(a.search));
			if (sv !== '' && match(sv, /^[A-Za-z0-9._:\-]{1,120}$/) != null) q += '&search=' + sv;
			if (t(a.only_blocked) === '1') q += '&response_status=blocked';
			let r = adgCall('GET', q, null, 8);
			if (r.code !== 200 || r.data == null) return { status: 4 };
			let nm = ipNameMap(), rows = [];
			for (let e in (r.data.data ?? [])) {
				let reason = t(e.reason);
				push(rows, {
					time: t(e.time), domain: t(e.question?.name), type: t(e.question?.type),
					client: t(e.client), name: nm[t(e.client)] ?? '',
					blocked: (index(reason, 'Filtered') === 0) ? 1 : 0, allowed: (reason === 'NotFilteredWhiteList') ? 1 : 0,
					rule: t(e.rule ?? e.rules?.[0]?.text), ms: e.elapsedMs ?? '', cached: e.cached ? 1 : 0
				});
			}
			return { status: 0, rows: rows };
		}
	},

	/* 「为什么这个网站被拦 / 没被拦」：{ domain } —— 返回命中的规则和来自哪份订阅。返回码：1 引擎没在运行 / 2 域名不合法 */
	web_adg_check: {
		call: function (req) {
			if (adgStatus().core !== 'running') return { status: 1 };
			let d = lc(trim(t(req.args?.domain)));
			if (!match(d, /^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$/)) return { status: 2 };
			let r = adgCall('GET', '/control/filtering/check_host?name=' + d, null, 8);
			if (r.code !== 200 || r.data == null) return { status: 4 };
			let reason = t(r.data.reason), lname = '';
			if (r.data.filter_id != null && r.data.filter_id > 0) {
				let f = adgCall('GET', '/control/filtering/status', null, 5);
				for (let x in (f.data?.filters ?? [])) if (x.id === r.data.filter_id) lname = t(x.name);
			}
			return { status: 0, domain: d, blocked: (index(reason, 'Filtered') === 0) ? 1 : 0, allowed: (reason === 'NotFilteredWhiteList') ? 1 : 0, rule: t(r.data.rule ?? r.data.rules?.[0]?.text), list: lname };
		}
	},

	/* 一键自检：把「广告过滤没效果」拆成用户看得懂的几项，每项给状态和建议动作（fix）。{ client_mac } 判断这台设备的查询有没有经过过滤 */
	web_adg_diagnose: {
		call: function (req) {
			let c = cfg('keladg'), st = adgStatus(), items = [];
			let add = function (id, title, state, msg, fix) { push(items, { id: id, title: title, state: state, msg: msg, fix: fix ?? '' }); };
			let en = t(c.get('keladg', 'main', 'enabled')) === '1';
			let ph = trim(split(rf('/tmp/keladg/phase') ?? '', '\n')[1] ?? '');
			if (!en) add('engine', '广告过滤引擎', 'off', '广告过滤没有开启。', 'start');
			else if (st.core !== 'running') add('engine', '广告过滤引擎', 'warn', (ph !== '') ? ph : '引擎正在启动，请稍等…', 'wait');
			else add('engine', '广告过滤引擎', 'ok', '引擎运行正常。');
			if (st.core === 'running') {
				let hl = trim(rf('/tmp/keladg/health') ?? '');
				if (st.rules) add('path', '查询转发', 'ok', '全家设备的域名查询已经先经过广告过滤。');
				else add('path', '查询转发', 'warn', (hl === 'probe-fail') ? '引擎暂时没有应答，为安全起见 DNS 保持原样（不影响上网），稍后会自动重试。' : '正在确认引擎可用，确认后自动接管域名查询。', 'wait');
				let f = adgCall('GET', '/control/filtering/status', null, 5);
				let n = 0, rules = 0, en2 = 0;
				for (let x in (f.data?.filters ?? [])) { n++; if (x.enabled) { en2++; rules += x.rules_count ?? 0; } }
				if (en2 === 0) add('lists', '过滤规则', 'bad', '没有启用任何过滤规则订阅，什么都不会被拦。', 'goRules');
				else if (rules === 0) add('lists', '过滤规则', 'warn', '订阅还没下载好（或下载失败），稍等片刻再点自检；也可以到「规则」页点「立即更新」。', 'refresh');
				else add('lists', '过滤规则', 'ok', '已启用 ' + en2 + ' 份订阅，共 ' + rules + ' 条规则。');
				let ck = adgCall('GET', '/control/filtering/check_host?name=doubleclick.net', null, 6);
				let rs = t(ck.data?.reason);
				if (ck.code !== 200) add('test', '实测拦截', 'warn', '暂时无法实测。');
				else if (index(rs, 'Filtered') === 0) add('test', '实测拦截', 'ok', '典型广告域名（doubleclick.net）能被正确拦截。');
				else add('test', '实测拦截', (rules > 0) ? 'warn' : 'off', (rules > 0) ? '典型广告域名没有被拦：这份订阅可能不含它，属于正常，可以再加一份订阅。' : '还没有规则，所以没有拦截。');
				let mac = normMac(t(req.args?.client_mac));
				let myIp = (mac !== '') ? (arpTable()[mac]?.ip ?? null) : null;
				if (myIp == null) add('device', '这台设备', 'warn', '没能识别出当前设备，无法判断它的查询是否经过过滤。');
				else {
					let ql = adgCall('GET', '/control/querylog?limit=20&search=' + myIp, null, 6);
					let cnt = length(ql.data?.data ?? []);
					if (cnt > 0) add('device', '这台设备', 'ok', '这台设备的域名查询正在经过广告过滤（最近有 ' + cnt + ' 条记录）。');
					else if (st.rules) add('device', '这台设备', 'warn', '暂时没有这台设备的查询记录。打开几个网站再点一次自检；如果一直没有，说明这台设备用了自己的 DNS（如 8.8.8.8），可以在设置里打开「强制全部设备使用」。');
					else add('device', '这台设备', 'warn', '查询转发还没生效，暂时没有这台设备的记录。', 'wait');
				}
			}
			let sum = 'ok';
			for (let it in items) { if (it.state === 'bad') { sum = 'bad'; break; } if (it.state === 'warn' && sum === 'ok') sum = 'warn'; }
			return { status: 0, items: items, summary: sum };
		}
	},

	/* 开机记录（看门狗在闪存里留的）：每次开机一行（开机时间/上次确认运行时间/间隔/判断）+ 上次停机前的 err/panic 类日志。 */
	web_get_boot_log: {
		call: function () {
			let ln = function (path) { let o = []; for (let x in split(trim(rf(path) ?? ''), '\n')) if (trim(x) !== '') push(o, x); return o; };
			return { status: 0, boots: ln('/etc/kel_boot.log'), lastlog: ln('/etc/kel_lastlog'), alive: trim(rf('/etc/kel_alive') ?? ''), uptime: int(split(trim(rf('/proc/uptime') ?? '0'), '.')[0]), now: time() };
		}
	},

	web_adg_events: {
		call: function () {
			return { status: 0, events: readEvents('/tmp/keladg/events'), health: trim(rf('/tmp/keladg/health') ?? '') };
		}
	},

	/* 立即更新社区分流规则（后台执行，约半分钟；页面看 web_get_clash 的 ruleset_at 变化）。返回码：1 未运行 */
	web_clash_rules_update: {
		call: function (req) {
			if (mihomoSecret() == null) return { status: 1 };
			sh('setsid /usr/share/kelclash/run.sh rules-sync >/dev/null 2>&1 < /dev/null &');
			return { status: 0, now: time() };
		}
	},

	/* 一键切到最快节点（和守护进程自动切换走同一个函数）。返回码：1 未运行 / 3 没有可用节点 */
	web_clash_best: {
		call: function (req) {
			if (mihomoSecret() == null) return { status: 1 };
			let out = trim(sh('/usr/share/kelclash/run.sh best 2>/dev/null'));
			if (out === '') return { status: 3 };
			let f = split(out, '\t');
			return { status: 0, name: f[0], delay: +(f[1] ?? 0) };
		}
	},

	/* 保存订阅前先检查：能不能打开、是不是订阅内容、有多少条节点。
	   返回码：2 链接格式不对 / 3 打不开（网络不通或站点不可达）/ 4 网站返回了错误码 / 5 打开的是网页不是订阅 / 6 里面没有节点 */
	web_clash_check_sub: {
		call: function (req) {
			let url = trim(t(req.args?.url));
			if (!match(url, /^https?:\/\/[^[:space:]"'`$\\]+$/) || length(url) > 1024) return { status: 2 };
			/* 可以带一个还没保存的客户端标识来试（页面上改了标识先点「只检查」）；不带就用已保存的 */
			let ua = trim(t(req.args?.ua));
			if (ua !== '' && !subUaOk(ua)) return { status: 2 };
			if (ua === '') ua = subUa(cfg('kelclash'));
			/* 🔴 必须看 curl 的退出码：订阅站多在境外，路由器直连它经常传到一半就断——这时 HTTP 状态码照样是 200，
			   以前只看状态码，把半截内容当成完整订阅去数节点（实测同一个订阅先后数出 20 条、15 条，完整的是 23 条，2026-10-13）。
			   直连失败而内核在跑时，改经本机代理端口再取一次：订阅站直连不稳、经节点却很快的情况很常见。
			   两次合计不超过 25 秒（rpcd 被占住超过 30 秒会让别的请求被判成未登录）。 */
			let fetch = function (via, tmo) {
				sh('rm -f /tmp/.kelsub.chk');
				let out = trim(sh("curl -sL -m" + tmo + " --max-filesize 3000000 " + via + "-A '" + ua + "' -o /tmp/.kelsub.chk -w '%{http_code}|%{content_type}|%{size_download}' '" + url + "' 2>/dev/null; echo \"|$?\""));
				let mm = match(out, /^([0-9]{3})\|([^|]*)\|([0-9]+)\|([0-9]+)$/);
				return (mm == null) ? null : { code: mm[1], size: +mm[3], rc: +mm[4] };
			};
			let via = '';
			let f = fetch('', 9);
			if ((f == null || f.rc !== 0 || f.code === '000') && mihomoSecret() != null && (json(sh('/usr/share/kelclash/run.sh status 2>/dev/null') || '{}')?.core === 'running')) {
				let f2 = fetch('-x http://127.0.0.1:7890 ', 15);
				if (f2 != null && f2.rc === 0 && f2.code !== '000') { f = f2; via = 'proxy'; }
			}
			if (f == null || f.code === '000' || (f.rc !== 0 && f.code === '200')) { sh('rm -f /tmp/.kelsub.chk'); return { status: 3 }; }
			if (f.code !== '200') { sh('rm -f /tmp/.kelsub.chk'); return { status: 4, code: f.code }; }
			let m = [ null, f.code, '', '' + f.size ];
			let body = rf('/tmp/.kelsub.chk') ?? '';
			let nodes = 0, fmt = '';
			if (match(body, /(^|\n)proxies:/) != null) {
				fmt = 'clash';
				/* 订阅里常夹着「剩余流量/到期时间/官网」这类假节点，和内核用同一套关键词排除，数出来才是真实节点数 */
				/* 服务器是本机回环地址（127.0.0.1 等）的也是假节点：有的机场停用某类客户端后，会把订阅换成一组
				   指向 127.0.0.1 的「公告节点」（如「当前版本已停止使用」）。以前把它们数成有效节点，导入后一条都连不上（2026-10-13）。
				   全是这种时把公告原文带回去给页面显示。 */
				/* 只数 proxies: 这一段里的条目，一条一条看：订阅可以是完整配置（后面还有策略组、规则，它们也有 name:），
				   条目可以写成一行 { name: … }、带引号的 {"name": …}，也可以分多行写、name 不在第一个——
				   以前按「行首是 - name:」数，后两种写法会数成 0 条，把有效订阅判成「里面没有找到节点」（2026-10-13）。 */
				let notice = [], inP = false, item = null;
				let flush = function () {
					if (item == null) return;
					/* name 前面必须是分隔符：不然 servername: 这类键会被当成 name */
					let nm = match(item, /(^|[{, \t\n-])["']?name["']?[ \t]*:[ \t]*["']?([^,'"}\n]+)/);
					let name = (nm != null) ? trim(nm[2]) : '';
					if (match(item, /["']?server["']?[ \t]*:[ \t]*['"]?(127\.[0-9.]+|localhost|0\.0\.0\.0|::1)['"]?[ \t]*([,}\n]|$)/) != null) {
						if (name !== '' && length(notice) < 3) push(notice, name);
					} else if (match(lc(name), /官网|网址|域名|状态|余额|到期|剩余|流量|套餐|重置|订阅|欠费|账户|账号|过期|公告|客服|防失联|续费|购买|expire|traffic|remaining|balance|website|renew|account/) == null) nodes++;
					item = null;
				};
				for (let ln in split(body, '\n')) {
					if (match(ln, /^proxies:/) != null) { inP = true; continue; }
					if (!inP) continue;
					if (match(ln, /^[A-Za-z]/) != null) { flush(); inP = false; continue; }	/* 下一个顶层键：这一段结束 */
					if (match(ln, /^[ \t]*-[ \t]/) != null) { flush(); item = ln; }
					else if (item != null) item += '\n' + ln;
				}
				flush();
				if (nodes === 0 && length(notice) > 0) { sh('rm -f /tmp/.kelsub.chk'); return { status: 7, notice: join('；', notice) }; }
			} else {
				let txt = body;
				/* 用 ucode 自带的 b64dec 解码：路由器上没有 base64 这个命令，以前这里调命令解码，结果永远是空的——
				   凡是「链接列表」格式的订阅都被判成「里面没有找到节点」（2026-10-13 发现） */
				if (match(body, /^[A-Za-z0-9+\/=\r\n]+$/) != null && length(body) > 20) txt = b64dec(replace(body, /[\r\n]/g, '')) ?? '';
				fmt = 'uri';
				let lo = 0;
				for (let ln in split(txt, '\n')) if (match(trim(ln), /^(vmess|vless|ss|ssr|trojan|hysteria2?|hy2|tuic):\/\//) != null) {
					if (match(ln, /@(127\.[0-9.]+|localhost|0\.0\.0\.0):/) != null) lo++; else nodes++;
				}
				if (nodes === 0 && lo > 0) { sh('rm -f /tmp/.kelsub.chk'); return { status: 7, notice: '' }; }
			}
			sh('rm -f /tmp/.kelsub.chk');
			if (nodes === 0) return { status: (match(body, /<(html|!doctype)/i) != null) ? 5 : 6, size: +m[3] };
			return { status: 0, nodes: nodes, format: fmt, size: +m[3], via: via };
		}
	},

	/* 一键自检：把「用不了」拆成用户看得懂的几项，每项给状态和一句人话 + 建议动作（fix）。
	   { client_mac } 用来判断「这台设备到底有没有在用加速」。 */
	web_clash_diagnose: {
		call: function (req) {
			let c = cfg('kelclash'), sec = mihomoSecret();
			let st = {};
			try { st = json(sh('/usr/share/kelclash/run.sh status')) ?? {}; } catch (e) { st = {}; }
			let items = [];
			let add = function (id, title, state, msg, fix) { push(items, { id: id, title: title, state: state, msg: msg, fix: fix ?? '' }); };
			let hasUrl = t(c.get('kelclash', 'main', 'sub_url')) !== '';
			let en = t(c.get('kelclash', 'main', 'enabled')) === '1';
			let tp = t(c.get('kelclash', 'main', 'transparent')) === '1';
			add('sub', '订阅链接', hasUrl ? 'ok' : 'bad', hasUrl ? '订阅链接已添加。' : '还没有添加订阅链接。', hasUrl ? '' : 'goSub');
			let ph = trim(split(rf('/tmp/kelclash/phase') ?? '', '\n')[1] ?? '');
			if (!en) add('engine', '内核', 'off', '内核未启动。', hasUrl ? 'start' : 'goSub');
			else if (st.core !== 'running') add('engine', '内核', 'warn', (ph !== '') ? ph : '内核正在启动…', 'wait');
			else add('engine', '内核', 'ok', '内核运行正常。');
			if (st.core === 'running' && sec != null) {
				let pv = mihomoGet(sec, '/providers/proxies/sub', 5);
				let total = 0, alive = 0, best = 0;
				for (let p in (pv?.proxies ?? [])) {
					total++;
					let h = p.history ?? [];
					let d = length(h) ? (h[length(h) - 1].delay ?? 0) : 0;
					if (d > 0) { alive++; if (best === 0 || d < best) best = d; }
				}
				if (total === 0) add('lines', '代理节点', 'bad', '未获取到任何节点：订阅可能已过期或链接有误。', 'update');
				else if (alive === 0) add('lines', '代理节点', 'bad', '共 ' + total + ' 条节点，全部测速失败：可能是网络问题或订阅已过期。', 'update');
				else if (alive * 3 < total) add('lines', '代理节点', 'warn', '共 ' + total + ' 条节点，只有 ' + alive + ' 条可用。', 'test');
				else add('lines', '代理节点', 'ok', '共 ' + total + ' 条节点，' + alive + ' 条可用，最快 ' + best + ' 毫秒。');
				let r = mihomoGet(sec, '/proxies/%E4%BB%A3%E7%90%86/delay?url=https%3A%2F%2Fwww.google.com%2Fgenerate_204&timeout=5000', 8);
				if (r != null && r.delay != null) add('foreign', '境外站点', 'ok', '境外站点经代理可达（' + r.delay + ' 毫秒）。');
				else add('foreign', '境外站点', 'bad', '境外站点经代理不可达：当前节点可能失效。', 'best');
				/* IPv6：有 IPv6 上联时透明代理必须同时接管 IPv6（站点优先走 AAAA，直连 IPv6 会被识别成国内出口，Claude/ChatGPT 这类有地区限制的服务就会失败） */
				let w6 = wan6Status();
				if (w6 && w6.up) {
					let c6 = trim(sh("nft list chain inet fw4 dstnat 2>/dev/null | grep -c kelclash6")) !== '0';
					if (!tp) add('ipv6', 'IPv6', 'off', '路由器已有 IPv6 上联；透明代理未启用，设备的 IPv6 流量直连。');
					/* 用户自己选了「IPv6 直连」：规则里没有 IPv6 是按设置来的，不是故障——以前这里会建议「重新启动内核」，重启也不会变（2026-10-13） */
					else if (t(c.get('kelclash', 'main', 'ipv6')) === 'direct') add('ipv6', 'IPv6', 'off', '已设置为「IPv6 直连」：设备的 IPv6 流量不经过代理，有地区限制的服务（Claude、ChatGPT 等）可能看到国内出口。可在「更多设置」里改为接管。');
					else if (c6) add('ipv6', 'IPv6', 'ok', '透明代理已同时接管 IPv6 TCP，设备不会经 IPv6 绕过代理。');
					else add('ipv6', 'IPv6', 'warn', '路由器有 IPv6 上联，但透明代理规则不含 IPv6：设备会经 IPv6 直连，有地区限制的服务（Claude、ChatGPT 等）会看到国内出口。重新启动内核以装入新规则。', 'restart');
				}
				/* 引擎自检：让内核用「直连出口」访问国内站（与模式、节点无关；「全部代理」下 curl 走代理口会绕国外节点而误判） */
				let dd = mihomoGet(sec, '/proxies/DIRECT/delay?url=http%3A%2F%2Fwww.baidu.com%2F&timeout=4000', 6);
				if (dd != null && dd.delay != null) add('domestic', '国内站点', 'ok', '国内站点直连正常（' + dd.delay + ' 毫秒）。');
				else add('domestic', '国内站点', 'bad', '内核直连国内站点失败，内核可能异常。', 'restart');
				/* 这台设备到底有没有在用加速 */
				let mac = normMac(t(req.args?.client_mac));
				let myIp = (mac !== '') ? (arpTable()[mac]?.ip ?? null) : null;
				if (!tp) add('device', '这台设备', 'off', '透明代理未启用，这台设备当前直连。', 'takeover');
				else if (myIp == null) add('device', '这台设备', 'warn', '无法识别当前设备，不能判断它是否经过代理。');
				else {
					let cj = mihomoGet(sec, '/connections', 5);
					let n = 0;
					for (let cn in (cj?.connections ?? [])) if (t(cn.metadata?.sourceIP) === myIp) n++;
					if (st.rules && n > 0) add('device', '这台设备', 'ok', '这台设备已被透明代理接管（当前有 ' + n + ' 条连接经过内核）。');
					else if (st.rules) add('device', '这台设备', 'warn', '透明代理已启用，但暂未看到这台设备的连接；访问几个站点后再自检。');
					else add('device', '这台设备', 'warn', '透明代理已请求，正在确认节点可用；确认通过前保持直连。', 'wait');
				}
			}
			let sum = 'ok';
			for (let it in items) { if (it.state === 'bad') { sum = 'bad'; break; } if (it.state === 'warn' && sum === 'ok') sum = 'warn'; }
			return { status: 0, items: items, summary: sum };
		}
