	web_set_wifi6_80211ax: {
		call: function (req) {
			let compat = (t(req.args?.enabled) === '1');	/* 兼容模式开？ */
			let c = cfg('wireless');
			let radios = [ 'radio0', 'radio1' ];
			for (let r in radios) {
				if (!c.get_all('wireless', r)) continue;
				c.set('wireless', r, 'ieee80211ax', compat ? '0' : '1');
				let band = t(c.get('wireless', r, 'band'));
				let hm = t(c.get('wireless', r, 'htmode'));
				/* 兼容模式 = 关 802.11ax，降回上一代：
				     5G → 802.11ac(VHT)、2.4G → 802.11n(HT)。
				   ⚠️ 2.4G 上写 VHT 是不合规组合，hostapd 会直接起不来
				   —— 必须按 band 分流，不能两射频一把梭。 */
				if (compat) hm = replace(hm, /^HE/, (band === '2g') ? 'HT' : 'VHT');
				else hm = replace(hm, /^(VHT|HT)/, 'HE');
				c.set('wireless', r, 'htmode', hm);
			}
			c.commit('wireless');
			wifiReload();
			return { status: 0 };
		}
	},

	web_get_wifi_scan_list: {
		/* 2.4G/5G 两个射频都扫。
		   去重：同名 SSID 就是同一个网络（同频多 BSSID / 双频同名广播），
		   只保留信号最强的一条，其余全是噪音。
		   ssid 按扫描原样返回，不做任何修饰（前端也不再追加 "(5G)"）。 */
		call: function () {
			let data = [];
			let devs = [ 'phy0-ap0', 'phy1-ap0' ];
			for (let d in devs) {
				let list = wifiScan(d);
				for (let x in list) push(data, x);
			}
			let best = {};
			let order = [];
			for (let i = 0; i < length(data); i++) {
				let x = data[i];
				if (x.ssid == null || x.ssid === '') continue;
				if (best[x.ssid] == null) {
					push(order, x.ssid);
					best[x.ssid] = x;
				} else if (num(x.rssi, -999) > num(best[x.ssid].rssi, -999)) {
					best[x.ssid] = x;
				}
			}
			let out = [];
			for (let i = 0; i < length(order); i++) push(out, best[order[i]]);
			return { data: out };
		}
	},

