			/* 空 IP 写进去 fw4 会生成无目标的 dnat；必须是 LAN 内主机 */
			let ip = t(a.ipaddr);
			if (!lanHostIPOk(ip)) return { status: 1 };
			let sid = found ?? c.add('firewall', 'redirect');
			c.set('firewall', sid, 'kel', '1');
			c.set('firewall', sid, 'name', '__dmz__');
			c.set('firewall', sid, 'target', 'DNAT');
			c.set('firewall', sid, 'src', 'wan');
			c.set('firewall', sid, 'dest', 'lan');
			c.set('firewall', sid, 'proto', 'all');
			c.set('firewall', sid, 'dest_ip', ip);
			fwDmzLast(c);
			c.commit('firewall');
			sh('/etc/init.d/firewall reload >/dev/null 2>&1');
			return { status: 0 };
		}
