	/* ========== 设备 / 限速 / 访问控制 ========== */

	web_get_device_list: {
		args: { stats: 'string' },
		call: function (req) {
			let stats = t(req.args?.stats) !== '0';
			if (stats) mdnsLearn();
			let leases = dhcpLeases(), neighbors = deviceIpv6Neighbors(), arp = arpTable();
			let seen = {};
			let list = [];

			/* 真实速率：现采一次，与 /tmp 里的上次采样做差值 */
			let prev = loadTraf();
			let cur = { t: uptimeNow(), iw: iwStationBytes() };
			/* stats=0（设备页首屏快读）时不采 conntrack、不落盘：采样节奏仍由带统计的轮询决定 */
			if (stats) { ctSample(prev, cur); saveTraf(cur); }
			let rateOf = trafficRate(prev, cur);

			/* ⚠️ 设备列表 = 连接本路由器的终端，数据源分三类：
			   ① 无线关联（station dump）→ 在线；
			   ② ARP 里 dev=br-lan/br-guest 的条目（flags!=0x0）**且**通过
			      wiredOnlineJudge() → 在线有线。
			      · dev=wan 的是上游网络设备（如上级路由、上游局域网终端），
			        全量列出会混进陌生设备 —— 这是之前"设备是错的"的根因；
			      · 光有 ARP 条目不够（flags 分不出 STALE/REACHABLE），
			        陈旧残留会变成幽灵「有线」设备（2026-09-23 实证）；
			   ③ DHCP 租约还在但上面两类都没有 → 离线（online='0'），
			      之前把历史租约一律标在线，同样是错的。 */

			/* ① 无线关联的终端 */
			let wm = keys(cur.iw);
			for (let i = 0; i < length(wm); i++) {
				let mac = wm[i];
				seen[mac] = 1;
				let l = leases[mac];
				let ar = arp[mac];
				let ip = (l != null) ? l.ip : (ar != null && (ar.dev === 'br-lan' || ar.dev === 'br-guest') && ar.flags !== '0x0' ? ar.ip : '');
				push(list, devItem(mac, ip, l ? l.name : '', true, rateOf(mac, ip), cur.iw));
			}

			/* ② LAN 侧有线在线终端（须通过第二重证据，见 wiredOnlineJudge 注释） */

			let isOnline = wiredOnlineJudge();
			let mk = keys(arp);
			for (let i = 0; i < length(mk); i++) {
				let mac = mk[i];
				let a = arp[mac];
				if (a.dev !== 'br-lan' && a.dev !== 'br-guest') continue;
				if (a.flags === '0x0') continue;
				if (seen[mac]) continue;
				if (!isOnline(mac)) continue;
				seen[mac] = 1;
				let l = leases[mac];
				push(list, devItem(mac, a.ip, l ? l.name : '', true, rateOf(mac, a.ip), cur.iw));
			}

			/* ③ 历史租约、当前不在线 → 离线设备 */
			let lk = keys(leases);
			for (let i = 0; i < length(lk); i++) {
				let mac = lk[i];
				if (seen[mac]) continue;
				seen[mac] = 1;
				push(list, devItem(mac, leases[mac].ip, leases[mac].name, false, null, cur.iw));
			}
			/* IPv6-only 设备也进入列表；缓存邻居不自动认定在线。 */
			for (let mac in keys(neighbors)) if (!seen[mac]) {
				let reachable = false;
				for (let n in neighbors[mac]) if (n.state === 'REACHABLE') reachable = true;
				/* 单纯旧 IPv6 缓存不创建设备；真实 IPv6-only 可达设备仍保留。 */
				let present = isOnline(mac);
				if (!reachable && !present) continue;
				seen[mac] = 1;
				let ar = arp[mac];
				let ip = ar != null && (ar.dev === 'br-lan' || ar.dev === 'br-guest') && ar.flags !== '0x0' ? ar.ip : '';
				push(list, devItem(mac, ip, '', present, null, cur.iw));
			}
			/* 稳定排序（2026-09-28）：station dump / ARP 的顺序每次都变，页面每 5 秒
			   重绘时行来回跳，点「编辑」会点错行。按 IP 数值升序，无 IP 的排后面。 */
			sort(list, function (a, b) {
				let x = ip4int(a.ip), y = ip4int(b.ip);
				if (x == null) x = 4294967296;
				if (y == null) y = 4294967296;
				return (x != y) ? ((x < y) ? -1 : 1) : ((a.id < b.id) ? -1 : (a.id > b.id) ? 1 : 0);
			});
			if (!stats) for (let d in list) { d.uplink = null; d.downlink = null; d.traffic_pending = true; }
			return enrichDevices(list, neighbors);
		}
	},

