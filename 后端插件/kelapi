	set_port_forward: {
		call: function (req) {
			/* 返回码是前端契约（portForward.js）：1 添加失败 / 2 名字超 64 字符 /
			   3 IP 不合法 / 4 端口非法 / 5 名称已存在。
			   edit=1 是「编辑」（名字不可改；改名时前端先 del 旧的再 edit=0 新建） */
			let a = req.args ?? {};
			let name = t(a.name);
			if (name === '' || match(name, /["\\[:cntrl:]]/)) return { status: 1 };
			if (u8len(name) > 64) return { status: 2 };
			let proto = fwProtoIn(a.proto ?? 'TCP');
			if (proto == null) return { status: 1 };
			let ip = t(a.ipaddr);
			if (!lanHostIPOk(ip)) return { status: 3 };
			let sp = portRange(a['src-dport']), dp = portRange(a['dest-port']);
			if (sp == null || dp == null) return { status: 4 };
			/* 内外端口范围长度必须一致（fw4 按偏移一一映射；单端口→单端口也满足） */
			if (sp[1] - sp[0] != dp[1] - dp[0]) return { status: 4 };
			let edit = (t(a.edit) === '1');
			let c = cfg('firewall');
			let found = null, clash = false;
			c.foreach('firewall', 'redirect', function (sec) {
				if (t(sec.kel) !== '1') return;
				if (t(sec.name) === name) { found = sec['.name']; return; }
				if (t(sec.name) === '__dmz__') return;
				/* 外部端口与其它规则重叠且协议有交集 → 后一条永远不生效 */
				let o = portRange(t(sec.src_dport));
				let op = fwProtoIn(fwProtoOut(sec.proto));
				if (o == null || op == null) return;
				let share = (op === proto) || op === 'tcp udp' || proto === 'tcp udp';
				if (share && o[0] <= sp[1] && sp[0] <= o[1]) clash = true;
			});
			if (name === '__dmz__') return { status: 5 };
			if (found && !edit) return { status: 5 };
			if (clash) return { status: 4 };
			let sid = found ?? c.add('firewall', 'redirect');
			c.set('firewall', sid, 'kel', '1');
			c.set('firewall', sid, 'name', name);
			c.set('firewall', sid, 'target', 'DNAT');
			c.set('firewall', sid, 'src', 'wan');
			c.set('firewall', sid, 'dest', 'lan');
			c.set('firewall', sid, 'proto', proto);
			c.set('firewall', sid, 'src_dport', t(a['src-dport']));
			c.set('firewall', sid, 'dest_ip', ip);
			c.set('firewall', sid, 'dest_port', t(a['dest-port']));
			c.set('firewall', sid, 'enabled', (a['on-off'] == null || t(a['on-off']) === '1') ? '1' : '0');
			fwDmzLast(c);
			c.commit('firewall');
			sh('/etc/init.d/firewall reload >/dev/null 2>&1');
			return { status: 0 };
		}
	},

