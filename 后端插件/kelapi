	web_get_ddns_status: {
		/* 🔴 前端行模板读 e.ddns_name / e.service（旧实现回 name、不回 service）→
		   每行 data-name="undefined"，编辑/启停/移除/手动更新全打到不存在的服务上。
		   🔴 conn_status 旧实现 =「进程在跑」，更新失败也显示「连接正常」。
		   现按 ddns-scripts 自己的记录：有成功注册的 IP → 1；启用后超过 3 分钟
		   仍无记录 → 2（失败）；否则 0（连接中）。wan_ip = 已注册的地址。 */
		call: function () {
			let info = [];
			let c = cfg('ddns');
			c.foreach('ddns', 'service', function (sec) {
				let slug = t(sec['.name']);
				let en = (t(sec.enabled) === '1') ? 1 : 0;
				let regIP = ddnsRun(slug, 'ip');
				let upd = int(ddnsRun(slug, 'update'));
				let up = ddnsUptime(slug);
				let cs = 0;
				if (en && regIP !== '') cs = 1;
				else if (en && up > 180) cs = 2;
				push(info, {
					ddns_name: (t(sec['kel_name']) !== '' ? t(sec['kel_name']) : slug),
					name: (t(sec['kel_name']) !== '' ? t(sec['kel_name']) : slug),
					service: ddnsSvcOut(sec.service_name),
					enabled: en,
					domain: t(sec.domain),
					wan_ip: regIP,
					conn_status: cs,
					/* 前端显示「最近更新」= formatTime(秒)：距上次成功更新的时长。
					   ⚠️ <段>.update 存的是**系统 uptime**（ddns-scripts: UPDFILE "store UPTIME
					   of last update"），不是 epoch —— 必须用 uptime 相减。 */
					wan_uptime: (upd > 0 && uptimeNow() > upd) ? int(uptimeNow() - upd) : 0
				});
			});
			return { info: info, status: 0 };
		}
