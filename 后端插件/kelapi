	for (let ip in keys(best)) {
		let mac = ip2mac[ip];
		if (mac == null || best[ip].name === '') continue;
		mac = uc(mac);
		let cur = P[mac], b = best[ip];
		if (cur == null || cur.name !== b.name || cur.kind !== b.kind || cur.model !== b.model || cur.src !== 'mdns') {
			P[mac] = { name: b.name, kind: b.kind, model: b.model, src: 'mdns', ts: now };
			changed = true;
		}
	}
	if (changed) devProfSave();
}

/* 综合识别：返回 { name, kind, src, random, model }。alias（用户改名）由调用方优先处理。
   src：alias / dhcp / mdns / fingerprint / random / none */
function devResolve(mac, hostname) {
	mac = uc(normMac(mac));
	let P = devProfiles()[mac];
	let rnd = macRandomized(mac);
	let hn = trim('' + (hostname ?? ''));
	if (hn === '*' || !mdnsHuman(hn)) hn = '';
	let out = { name: '', kind: '', src: 'none', random: rnd, model: P?.model ?? '' };
	let hk = (hn !== '') ? kindFromHostname(hn) : '';
	if (P != null && mdnsHuman(P.name) && (hn === '' || hostGeneric(hn))) { out.name = P.name; out.src = P.src; out.kind = P.kind; }
	else if (hn !== '') { out.name = hn; out.src = 'dhcp'; out.kind = (P?.kind ?? '') || hk; }
	if (out.name !== '') { if (out.kind === '') out.kind = (P?.kind ?? '') || hk; return out; }
	for (let line in splitLines(rf('/tmp/kel_dhcpfp/' + lc(mac)))) {
		let m = match(line, /^host=(.*)$/);
		if (m != null && mdnsHuman(m[1])) { out.name = m[1]; out.src = 'dhcp'; out.kind = kindFromHostname(m[1]); return out; }
