	/* 代理加速（mihomo）—— 全部落在 uci kelclash + /etc/init.d/kelclash（procd）。
	   程序跑在 /tmp（开机从镜像下载、校验 sha256），闪存只存脚本与文本配置；
	   透明代理规则是 fw4 include，mihomo 不在/不健康时 guard 自动撤掉 → 全家直连。
	   节点/延迟/订阅用量：走 mihomo 自带控制接口（127.0.0.1:9090，密钥在 uci）。 */
	web_get_clash: {
		call: function () {
			if (!access('/etc/init.d/kelclash')) return { status: 1 };
			let c = cfg('kelclash');
			let st = {};
