/* ========== DDNS 辅助（放在 methods 之外，对象字面量里不能声明 function）========== */
	function ddnsConfPath() {
		/* 确保 /etc/config/ddns 存在：uci 在文件不存在时写操作静默失败 */
		return ensureConf('ddns', "# DDNS configuration (managed by kelapi)\n");
	}
const DDNS_PW_KEEP = '••••••••';
function ddnsSlug(name) {
	/* 把任意 ddns_name（可含中文/空格）映射成**稳定且唯一**的 alnum section 名：
	   · uci section 名不能以 _ 开头；
	   · 若直接按字符规整，不同中文名可能都变成 ______ 而撞名、互相覆盖；
	   · 用 djb2 哈希得到 8 位十六进制后缀，前缀 kel，保证合法且极少碰撞。
	   原始名单独存进 option kel_name 供显示/回查（ddnsSectionFor 按它精确匹配）。 */
	let s = '' + name;
	let h = 5381;
	let chars = split(s, '');
	for (let i = 0; i < length(chars); i++)
		h = (h * 33 + ord(chars[i])) & 0xffffffff;
	return 'kel' + sprintf('%08x', h);
}
	function ddnsSectionFor(name) {
		let want = t(name);
		let slug = ddnsSlug(want);
		let c = cfg('ddns');
		let hit = null;
		c.foreach('ddns', 'service', function (sec) {
			let sn = t(sec['kel_name']);
			let key = t(sec['.name']);
			if (sn !== '' && sn === want) hit = key;
			else if (sn === '' && key === slug) hit = key;
		});
		return (hit != null) ? hit : slug;
	}
	function ddnsRestart() {
		if (access('/etc/init.d/ddns'))
			sh('/etc/init.d/ddns restart >/dev/null 2>&1');
	}
	/* 前端服务商 ↔ ddns-scripts 服务名（/usr/share/ddns/default/*.json）。
	   腾讯云 DNS 就是 DNSPod API v3（ddns-scripts-dnspod-v3 → dnspod.cn-v3）。 */
	const DDNS_SVC_IN = { 'cloud.tencent.com': 'dnspod.cn-v3' };
	function ddnsSvcIn(ui) { let v = t(ui); return DDNS_SVC_IN[v] ?? v; }
	function ddnsSvcOut(sn) {
		sn = t(sn);
		for (let k in keys(DDNS_SVC_IN)) if (DDNS_SVC_IN[k] === sn) return k;
		return sn;
	}
	/* ddns-scripts 运行态：/var/run/ddns/<段>.ip = 最后一次**成功注册**的地址
	   （失败时写空），<段>.update = 该次的系统 uptime。 */
	function ddnsRun(slug, ext) { return trim(rf('/var/run/ddns/' + slug + '.' + ext)); }
	function isPrivIPv4(ip) {
		return match('' + ip, /^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.)/) != null;
	}
	function ddnsWanIP() {
		let st = ifstatus('wan');
		let a = firstAddr(st, 'ipv4');
		return (a && a.address) ? '' + a.address : '';
	}
	function ddnsUptime(slug) {
		let raw = sh("ubus call service list '{\"name\":\"ddns\"}' 2>/dev/null");
		if (raw === '') return 0;
		let j = null;
		try { j = json(raw); } catch (e) { return 0; }
		if (!j || !j.ddns || !j.ddns.instances) return 0;
		let inst = j.ddns.instances[slug];
		if (!inst || inst.start_time == null) return 0;
		let up = time() - int(inst.start_time);
		return (up > 0) ? up : 0;
	}

