			c.set('upnpd', 'config', 'enabled', en ? '1' : '0');
			c.commit('upnpd');
			sh('/etc/init.d/miniupnpd ' + (en ? 'start' : 'stop') + ' >/dev/null 2>&1');
			return { status: 0 };
		}
