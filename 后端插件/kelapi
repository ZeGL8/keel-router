	camera: '摄像头', iot: '智能家居', game: '游戏机', nas: '存储设备', watch: '手表', other: '' };

let _devProf = null;
function devProfiles() {
	if (_devProf != null) return _devProf;
	_devProf = {};
	for (let ln in splitLines(rf(DEVFILE))) {
		let f = split(trim('' + ln), '|');
		if (length(f) < 5 || !isMAC(f[0])) continue;
		_devProf[uc(normMac(f[0]))] = { name: f[1], kind: f[2], model: f[3], src: f[4], ts: int(f[5] ?? '0') };
