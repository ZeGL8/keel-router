	   测速由页面逐个节点调 web_clash_delay 完成（有实时进度），这里不再后台乱跑。
	   返回码：1 内核未运行 / 3 更新失败（订阅站不通、返回的不是订阅内容等，内核保持旧节点不变） */
	web_clash_refresh: {
		call: function (req) {
			let sec = mihomoSecret();
			if (sec == null) return { status: 1 };
			let code = trim(sh("curl -s -m18 -o /dev/null -w '%{http_code}' -X PUT -H 'Authorization: Bearer " + sec + "' 'http://127.0.0.1:9090/providers/proxies/sub'"));
			let pv = mihomoGet(sec, '/providers/proxies/sub', 5);
			let n = length(pv?.proxies ?? []);
			if (code !== '204' && code !== '200') return { status: 3, nodes: n, code: code };
			return { status: 0, nodes: n, updated_at: pv?.updatedAt ?? '' };
		}
