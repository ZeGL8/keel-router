	set_dmz: {
		call: function (req) {
			let a = req.args ?? {};
			let on = (t(a.on_off) === '1');
			let c = cfg('firewall');
			let found = null;
			c.foreach('firewall', 'redirect', function (sec) {
				if (t(sec.kel) === '1' && t(sec.name) === '__dmz__') found = sec['.name'];
