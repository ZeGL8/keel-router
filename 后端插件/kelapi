				return { enabled: 0, ssid: '', encryption: '', key: '', band: 0, channel: '' };
			let band = (t(sec.device) === 'radio1') ? 1 : 0;
			let dev = (band === 1) ? 'phy1-sta0' : 'phy0-sta0';
			let ch = '';
