	get_upnp: {
		call: function () {
			let en = 0;
			if (access('/etc/init.d/miniupnpd')) {
				let c = cfg('upnpd');
				en = (t(c.get('upnpd', 'config', 'enabled')) === '1') ? 1 : 0;
			}
			/* 映射表以防火墙里**实际生效**的规则为准（nft upnp_prerouting 链）。
			   租约文件（upnp_lease_file）不会清理过期项、端口也常与实际规则对不上（2026-10-12 实测：文件 19 条，生效 2 条），
			   只拿它按「内部 IP + 内部端口」补描述。 */
			let data = [];
			if (en) {
				let desc = {};
				let lf = t(cfg('upnpd').get('upnpd', 'config', 'upnp_lease_file'));
				for (let ln in split(rf((lf !== '') ? lf : '/var/run/miniupnpd.leases') ?? '', '\n')) {
					let f = split(trim(ln), ':');
					if (length(f) >= 6) desc[f[2] + ':' + f[3]] = join(':', slice(f, 5));
				}
				for (let ln in split(sh('nft list chain inet fw4 upnp_prerouting 2>/dev/null'), '\n')) {
					let m = match(ln, /dport ([0-9]+) dnat ip to ([0-9.]+):([0-9]+)/);
					if (m == null || !isIPv4(m[2])) continue;
					/* ⚠️ 键名故意交叉：UPnP.js 把 inner_port 渲染在「外部端口」列、
					   outer_port 渲染在「内部端口」列（原厂契约如此，2026-09-28 核对表头）。 */
					push(data, { proto: (index(ln, '0x11') >= 0 || index(ln, 'udp') >= 0) ? 'UDP' : 'TCP', inner_port: m[1], ipaddr: m[2], outer_port: m[3],
						desc: desc[m[2] + ':' + m[3]] ?? '' });
				}
			}
			return { data: data, enable: en, status: 0 };
		}
	},

	set_upnp: {
		call: function (req) {
