/* ---- 设备入站放行（IPv6）：允许外网访问局域网里某台设备的指定端口 ----
   IPv6 下设备有自己的公网地址，不需要端口转发，路由器只负责放行。全部落在 OpenWrt 原生配置里，LuCI 看得到、改得了：
     防火墙：每台设备每种协议一条 rule（段名 kel_in_<mac12>_<tcp|udp>，src wan → dest lan，family ipv6）；
            dest_ip 只匹配地址后半段（::后缀/-64）——运营商换前缀后照样有效（2026-10 两次换前缀，写死完整地址的规则都失效了）。
     后半段的来源按设备情况自动选：
       dhcp  —— 设备向路由器领了 DHCPv6 地址：把它当前的编号固定给它（dhcp host 的 duid + hostid，即 LuCI 的静态地址分配），后半段 = ::编号
       eui64 —— 设备有由 MAC 生成的后半段（…ff:fe…），本身就固定
     两样都没有就不放行，并说明原因（不做「按当前地址放行、换前缀就失效」的半成品）。 */
const INBOUND_PROTOS = [ 'tcp', 'udp', 'all' ];
function inboundSec(mac, proto) { return 'kel_in_' + lc(replace(normMac(mac), /:/g, '')) + '_' + proto; }
/* 每台设备已放行的端口：{ MAC大写: [ { proto, port } ] }（一次读完整份防火墙配置，设备列表用） */
function inboundAll() {
	let out = {};
	cfg('firewall').foreach('firewall', 'rule', function (s) {
		let m = match(s['.name'], /^kel_in_([0-9a-f]{12})_(tcp|udp|all)$/);
		if (m == null) return;
		let mac = uc(join(':', map(match(m[1], /../g), x => x[0])));
		out[mac] ||= [];
		if (m[2] === 'all') { push(out[mac], { proto: 'all', port: '' }); return; }		/* 全部端口 */
		for (let p in split(trim(join(' ', listOpt(s.dest_port))), /\s+/)) if (p !== '') push(out[mac], { proto: m[2], port: p });
	});
	return out;
}
function dhcpHostOf(c, mac) {
	let found = null;
	c.foreach('dhcp', 'host', function (sec) { if (found == null && index(hostMacs(sec.mac), normMac(mac)) >= 0) found = sec; });
	return found;
}
/* 一次读好邻居表、DHCPv6 租约、dhcp 配置，给多台设备共用（总览页一次算全家，不重复读） */
function inboundCtx() {
	let leases = {};
	try { leases = json(sh('ubus -t 5 call dhcp ipv6leases 2>/dev/null')) ?? {}; } catch (e) {}
	return { neigh: deviceIpv6Neighbors(), leases: leases, dhcp: cfg('dhcp'), probed: null };
}
function euiIid(mac) {
	let b = map(split(mac, ':'), x => hex(x));
	return sprintf('%x:%x:%x:%x', ((b[0] ^ 2) << 8) | b[1], (b[2] << 8) | 0xff, 0xfe00 | b[3], (b[4] << 8) | b[5]);
}
/* 由 MAC 生成的地址不在邻居表时，按设备的前缀拼出来的候选地址（拼不出来返回 ''） */
function euiCandidate(mac, ctx) {
	for (let n in filter(ctx.neigh[mac] ?? [], n => n.scope === 'global')) {
		let g = split(lc(n.address), ':');
		if (length(g) < 4 || (index(n.address, '::') >= 0 && index(n.address, '::') < 15)) continue;	/* 前 64 位里有压缩的不好拼 */
		return join(':', slice(g, 0, 4)) + ':' + euiIid(mac);
	}
	return '';
}
/* 设备地址的「固定后半段」：{ method: 'dhcp'|'eui64'|'', suffix: '::26d', duid, hostid, address: 当前持有的公网地址或 '' } */
function inboundSuffix(mac, ctx) {
	mac = uc(normMac(mac)); ctx ??= inboundCtx();
	let mine = filter(ctx.neigh[mac] ?? [], n => n.scope === 'global');
	let held = function (sfx) { for (let n in mine) if (substr(lc(n.address), -length(sfx)) === sfx) return n.address; return ''; };
	let h = dhcpHostOf(ctx.dhcp, mac);
	if (h != null && t(h.duid) !== '' && match(t(h.hostid), /^[0-9a-f]{1,8}$/) != null) {
		let sfx = '::' + t(h.hostid);
		return { method: 'dhcp', suffix: sfx, duid: t(h.duid), hostid: t(h.hostid), address: held(sfx) };
	}
	for (let dev in keys(ctx.leases.device ?? {})) for (let l in (ctx.leases.device[dev].leases ?? []))
		for (let a in (l['ipv6-addr'] ?? [])) for (let n in mine) if (lc(n.address) === lc(a.address) && match(t(l.duid), /^[0-9a-f]{4,255}$/) != null && (l.assigned ?? 0) > 0) {
			let hid = sprintf('%x', l.assigned);
			return { method: 'dhcp', suffix: '::' + hid, duid: t(l.duid), hostid: hid, address: n.address };
		}
	let iid = euiIid(mac);
	if (held(':' + iid) !== '') return { method: 'eui64', suffix: '::' + iid, address: held(':' + iid) };
	/* 邻居表里只有设备「最近用过」的地址：由 MAC 生成的那个它可能有、只是没用来上网。问一下（ping 一次；总览页事先批量问好） */
	let cand = euiCandidate(mac, ctx);
	if (cand !== '' && (ctx.probed != null ? ctx.probed[cand] : trim(sh("ping6 -c 1 -W 1 -I br-lan '" + cand + "' >/dev/null 2>&1; echo $?")) === '0'))
		return { method: 'eui64', suffix: '::' + iid, address: cand };
	return { method: '', suffix: '', address: '' };
}

function enrichDevices(list, neighbors) {
	let block = ipv6BlockState(), filter=macfilterState(), oui = {}, inb = inboundAll();
	try { oui = json(rf('/usr/share/kel/oui-cache.json')) ?? {}; } catch (e) {}
	for (let d in list) {
		let mac = uc(normMac(d.id));
		d.ipv6_addresses = neighbors[mac] ?? [];
		d.inbound = inb[mac] ?? [];
		d.ipv6_enabled = index(block.blocked, mac) < 0;
		d.ipv6_active_enabled = index(block.active, mac) < 0;
		d.ipv6_applied = block.applied;
		d.net_enable = deviceAccessAllowed(mac,filter);
		d.access_known=!filter.custom;
		d.dev_local_mac = macRandomized(mac);
		let prefix = replace(substr(mac, 0, 8), /:/g, '');
		d.dev_vendor = d.dev_local_mac ? '' : (oui.vendors?.[prefix] ?? '');
		d.dev_vendor_source = d.dev_vendor !== '' ? (oui.source ?? '') : '';
		if (d.dev_src === 'random' || d.dev_src === 'none' || d.dev_src === 'fingerprint') d.name = '';
		d.dev_kind_zh = KIND_ZH[d.dev_kind ?? ''] ?? '';
		d.online_evidence = d.online === '1' ? (d.type !== 'wire' ? '无线关联' : '局域网在线判断') : '历史记录';
		for (let n in d.ipv6_addresses) if (n.state === 'REACHABLE') {
			if (d.online !== '1') { d.online = '1'; d.online_evidence = 'IPv6邻居可达'; }
		}
	}
	return { device_list: list, observed_at: time(), ipv6_applied: block.applied, vendor_data_updated: oui.downloaded_at ?? '' };
}

function devItem(mac, ip, name, online, rate, iw) {
	let band = (online && iw != null) ? wirelessBand(iw, mac) : null;
	/* 这台设备的 qos 段只找一次、配置只读一次：以前 5 个字段各自 qosGet/netEnableGet，每台设备要加载配置 10 次，
	   设备列表 1.5 秒里大半耗在这上面（2026-10-30 实测） */
	let qid = qosFind(mac), qc = qid ? cfg(KEL) : null;
	let qv = function (opt, dflt) { let v = qid ? qc.get(KEL, qid, opt) : null; return (v == null || v === '') ? dflt : v; };
	let qname = qv('name', '');
	let dr = devResolve(mac, name);
	let r = (rate != null) ? rate : { u: 0, d: 0 };
	return {
		id: mac,
		ip: ip ?? '',
		/* 名字三级兜底：用户改过的名（uci kel.qos） → DHCP/关联拿到的名 → 占位名。
		   为什么必须有第三级：前端 deviceList.js 把 name 直接拼进
		   `<li class='name'>`，**空串会渲染成零高度的浮动单元格**，Chrome 下
		   后续 float 不推进 → 整行列错位（2026-09-23 用户截图实证）。
		   这对「静态 IP 且没上报主机名的有线设备」是必然场景，不能靠"以后不会有"。
		   ⚠️ 占位名不会污染数据：「编辑」弹窗的 #uname 与 #oldName 都取自
		   siblings()[0].innerText（同一个格子），保存时 `v != h` 才写 uci，
		   所以不手改就不会把「未知设备」写进配置。 */
		name: (qname !== '') ? qname : dr.name,
		dev_kind: (qname !== '') ? (dr.kind ?? '') : (dr.kind ?? ''),
		dev_src: (qname !== '') ? 'alias' : dr.src,
		/* 手动命名时，设备自己上报的名字也带上：两者对不上（起错名、MAC 被别的设备占用）时页面并排显示，一眼能看出来 */
		reported_name: (qname !== '' && (dr.src === 'dhcp' || dr.src === 'mdns')) ? dr.name : '',
		dev_random: dr.random,
		dev_model: dr.model ?? '',
		online: online ? '1' : '0',
		/* 🔴 单位是 **KB/s**（2026-09-27 修）：前端 deviceList.js 的 _(t) 把入参当 KB/s——
		   ≤1024 原样标「KB/s」，>1024 才 ÷1024 标「MB/s」。旧实现回字节/秒，
		   空闲的本机显示 11.31 MB/s（实测真实 0.01 MB/s），全部放大 1024 倍。 */
		/* 字符串两位小数：ucode 序列化 double 会出 5.8300000000000001，
		   前端 ≤1024 时原样拼接显示（2026-09-28 实测页面上一长串小数） */
		uplink: sprintf('%.2f', r.u / 1024.0),
		downlink: sprintf('%.2f', r.d / 1024.0),
		type: band ?? 'wire',
		qos_enable: qv('enable', '0'),
		qos_upload: qv('upload', '102400'),
		qos_download: qv('download', '102400'),
		net_enable: (t(qv('net_enable', '1')) === '0') ? '0' : '1',
		/* 访客网段（ensureGuestNet：br-guest 192.168.2.1/24）里的设备标访客 */
		is_guest: (substr('' + ip, 0, 10) === '192.168.2.') ? 1 : 0,
		is_remesh: 0
	};
}

/* 设备显示名：用户改的名 > 综合识别（DHCP 主机名 / mDNS 真名 / 指纹 / 类型 + MAC 尾号） */
function devDisplayName(mac, hostname) {
	let q = qosGet(uc(normMac(mac)), 'name', '');
	return (q !== '') ? q : devResolve(mac, hostname).name;
}

/* ==================================================================== */
/* 守护事件文件（kelclash / keladg 共用）+ 广告过滤（AdGuardHome）辅助函数 */
/* ==================================================================== */
/* 事件文件每行 时间戳|类型|一句话；老格式（无类型）按 info 处理 */
function readEvents(path) {
	let out = [];
	for (let ln in split(rf(path) ?? '', '\n')) {
		let m = match(ln, /^([0-9]+)\|([a-z_]+)\|(.*)$/);
		if (m != null) push(out, { t: +m[1], k: m[2], m: m[3] });
		else {
			m = match(ln, /^([0-9]+)\|(.*)$/);
			if (m != null) push(out, { t: +m[1], k: 'info', m: m[2] });
		}
	}
	return out;
}

/* IP → 设备名（和设备列表同一套识别：别名 > 主机名 > mDNS > 指纹 > 带尾号的占位名） */
function ipNameMap() {
	let m = {};
	let ls = dhcpLeases();
	for (let mac in keys(ls)) if (t(ls[mac].ip) !== '') m[ls[mac].ip] = devDisplayName(mac, t(ls[mac].name));
	let ar = arpTable();
	for (let mac in keys(ar)) if (ar[mac].dev !== 'wan' && m[ar[mac].ip] == null) m[ar[mac].ip] = devDisplayName(mac, '');
	m['127.0.0.1'] = '路由器本机'; m['::1'] = '路由器本机';
	return m;
}

/* AdGuardHome 控制接口（只监听 127.0.0.1:3000，AdGuardHome 自带的登录已关闭——外面有 Keel UI 的会话保护）。
   返回 { code: HTTP 状态码, data: 解析后的 JSON 或 null, raw: 原文 }；传输失败 code=0 */
function adgCall(method, path, body, tmo) {
	let out = '/tmp/.keladg.out', bf = '/tmp/.keladg.body';
	sh('rm -f ' + out);
	let data = '';
	if (body != null) { wf(bf, sprintf('%J', body)); data = ' --data-binary @' + bf; }
	let code = trim(sh('curl -s -m' + (tmo ?? 6) + ' -X ' + method + " -H 'Content-Type: application/json'" + data + ' -o ' + out + " -w '%{http_code}' 'http://127.0.0.1:3000" + path + "' 2>/dev/null"));
	let raw = rf(out) ?? '';
	sh('rm -f ' + out + ' ' + bf);
	let j = null; try { j = json(raw); } catch (e) {}
	return { code: +code || 0, data: j, raw: raw };
}
/* 过滤规则列表的慢操作（添加/启停/更新：引擎要下载并解析规则，几秒到一分多钟）放后台做。
   🔴 rpcd 是串行的，而 uhttpd 每个请求都要先问 rpcd「这个会话有没有权限」，最多等 30 秒——rpcd 被一个慢接口占住超过
   30 秒时，浏览器的其他请求全部被判成 Access denied，页面以为登录过期把人踢回登录页（2026-10-13 定位）。
   所以任何可能超过十来秒的事都不能在接口里同步做。状态在 /tmp/keladg/fjob.state：running|操作 / ok|操作 / fail|操作|原因。 */
function adgJob(op, path, body, tmo) {
	if (index(rf('/tmp/keladg/fjob.state') ?? '', 'running|') === 0 && access('/tmp/keladg/fjob.lock')) return { status: 6 };
	wf('/tmp/keladg/fjob.body', sprintf('%J', body));
	wf('/tmp/keladg/fjob.state', 'running|' + op + '\n');
	sh('/usr/share/keladg/run.sh filter-job ' + op + " '" + path + "' " + tmo + ' >/dev/null 2>&1 &');
	return { status: 0, pending: 1 };
}
/* 升级地址：只接受 http(s)://，不含会进 shell 的字符；'' 表示用已保存的地址；不合法返回 null */
function upgradeUrl(v) {
	v = trim(t(v));
	if (v === '') return '';
	if (!match(v, /^https?:\/\/[A-Za-z0-9._~:\/%@+-]+$/) || length(v) > 300) return null;
	return v;
}
function adgStatus() {
	try { return json(sh('/usr/share/keladg/run.sh status 2>/dev/null')) ?? {}; } catch (e) { return {}; }
}
/* 「有几条 {名字: 次数}」→ [{name, count}] */
function adgTop(list, nameMap) {
	let out = [];
	for (let o in (list ?? [])) for (let k in keys(o)) push(out, { name: (nameMap != null && (nameMap[k] ?? '') !== '') ? nameMap[k] : k, key: k, count: o[k] });	/* 没认出名字的设备显示地址，不留空 */
	return out;
}
/* 文本里有控制字符、引号或反斜杠就拒绝（ucode 正则里不能写 \x 范围，逐字节判断） */
function adgBadText(str) {
	for (let i = 0; i < length(str); i++) {
		let c = ord(str, i);
		if (c < 32 || c === 34 || c === 92 || c === 127) return true;
	}
	return false;
}
/* 按服务选节点的取值：'' | follow | region:美国,日本（只认下面这几个地区）| node:<节点名> */
/* 服务键：与 kelclash/run.sh 的 SVC_LIST、clash.html 的 SVCS 保持一致；uci 选项名是 svc_<键> */
const SVC_KEYS = [ 'ai', 'google', 'media', 'telegram', 'twitter', 'github' ];
/* 服务键 -> 内核里的策略组名（run.sh SVC_LIST 的右半边） */
const SVC_GROUP = { ai: 'AI', google: 'Google', media: '流媒体', telegram: 'Telegram', twitter: 'X', github: 'GitHub' };
const SVC_REGIONS = [ '美国', '日本', '新加坡', '香港', '台湾', '韩国', '英国', '德国' ];
function svcRead(c) {
	let o = {};
	for (let k in SVC_KEYS) o[k] = t(c.get('kelclash', 'main', 'svc_' + k)) || 'follow';
	return o;
}
/* 拉订阅时报给机场的「客户端标识」（User-Agent）。会写进内核配置的双引号里、也会进 shell 的单引号里，
   所以只放行字母数字和几种常见符号；'' 表示用默认值 */
const SUB_UA_DEFAULT = 'clash.meta';
function subUaOk(v) { return v === '' || match(v, /^[A-Za-z0-9._\/ ()+:;,-]{1,100}$/) != null; }
function subUa(c) { let v = t(c.get('kelclash', 'main', 'ua')); return (v !== '' && subUaOk(v)) ? v : SUB_UA_DEFAULT; }
function svcValueOk(v) {
	if (v === '' || v === 'follow') return true;
	if (index(v, 'region:') === 0) {
		let list = split(substr(v, 7), ',');
		if (length(list) < 1 || length(list) > 8) return false;
		for (let r in list) if (index(SVC_REGIONS, r) < 0) return false;
		return true;
	}
	if (index(v, 'node:') === 0) {
		let n = substr(v, 5);
		return (length(n) >= 1 && length(n) <= 120 && !adgBadText(n) && index(n, "'") < 0);
	}
	return false;
}
/* 自定义规则（每行一条 AdGuard 语法）的读写：读出当前列表，改完整体写回 */
function adgUserRules() {
	let r = adgCall('GET', '/control/filtering/status', null, 5);
	return (r.code === 200 && r.data != null) ? (r.data.user_rules ?? []) : null;
}

/* ==================================================================== */
/* IPv6 —— 映射到 OpenWrt 的 network.wan6 / dhcp.lan(odhcpd) / firewall */
/* ==================================================================== */
/* Keel UI 给了 7 种模式，OpenWrt 上一一对应：
 *
 *   native      自动获取     wan6=dhcpv6 ; lan: ra=server + dhcpv6=server（混合，默认）
 *   onlyrouter  仅路由器获取 wan6=dhcpv6 ; lan: ra=disabled + dhcpv6=disabled
 *   relay       桥接         wan6=dhcpv6 ; lan: ra/dhcpv6/ndp 全 relay + master
 *   nat6        NAT6         wan6=dhcpv6 ; lan: server ; firewall wan zone masq6=1
 *   static      静态IPv6     wan6=static(ip6addr/ip6gw) ; lan 用给定前缀
 *   dhcpv6      有状态       lan: ra=server + dhcpv6=server + ra_flags managed-config
 *   slacc       无状态       lan: ra=server + dhcpv6=disabled + ra_slaac=1
 *
 * ⚠️ native / dhcpv6 / slacc 三者在 uci 上的差异很细（都可能是 ra=server），
 *    纯靠 uci 反推容易判错，所以把用户选的模式另记一份到 kel.settings.ipv6_mode，
 *    读时以 network/dhcp/firewall 的实际配置反推，不再使用独立模式缓存。
 *
 * ⚠️ firewall 的 zone 是**匿名 section**（uci show 显示 firewall.@zone[1]）。
 *    实测：foreach 回调里 sec['.name'] 才是内部键（形如 cfg03dc81），
 *    sec['name'] 是用户可见的 "wan"。写 masq6 必须用前者。
 *
 * ⚠️ uci 写 list 必须**传数组**：set(conf, sec, opt, [a, b])。
 *    实测 set(conf, sec, opt, a, b)（多个值）**什么都不会写**，而且不报错。
 */
const IPV6_MODES = [ 'native', 'onlyrouter', 'relay', 'nat6', 'static', 'dhcpv6', 'slacc' ];

function isIPv6Mode(m) {
	for (let x in IPV6_MODES) if (x === m) return true;
	return false;
}

function odhcpdReload() { sh('/etc/init.d/odhcpd restart >/dev/null 2>&1'); }
function fwReload() { sh('/etc/init.d/firewall reload >/dev/null 2>&1'); }

/* "240e::1/64" → "240e::1"；"240e::1" → "240e::1"
   （不去用 index()，ucode 里 split 更稳） */
function bareV6(s) {
	let a = split('' + s, '/');
	return (a && length(a) > 0) ? ('' + a[0]) : ('' + s);
}

/* "240e::1/64" → "64"；没写前缀长度就返回 '' */
function v6Plen(s) {
	let a = split('' + s, '/');
	return (a && length(a) > 1) ? ('' + a[1]) : '';
}

/* 取出 firewall 里名叫 wan 的那个匿名 zone 的内部键；找不到返回 null */
function fwZoneKey(c) {
	let k = null;
	c.foreach('firewall', 'zone', function (sec) {
		if (k == null && sec['name'] === 'wan') k = '' + sec['.name'];
	});
	return k;
}

/* 往 wan 上写一个选项（自动解析匿名 section） */
function fwWanSet(c, opt, val) {
	let k = fwZoneKey(c);
	if (k == null) return false;
	c.set('firewall', k, opt, val);
	return true;
}

function fwWanDel(c, opt) {
	let k = fwZoneKey(c);
	if (k != null) c.delete('firewall', k, opt);
}

function fwWanGet(c, opt) {
	let k = fwZoneKey(c);
	if (k == null) return null;
	return c.get('firewall', k, opt);
}

/* 「IPv6 防火墙」总开关 → OpenWrt 的一条具名规则（LuCI 里看得见、能改）。
 * 开着（规则停用）＝ OpenWrt 默认：外网不能主动访问家里设备；关掉（规则启用）＝ 外网可以访问家里**所有设备**。
 * 🔴 2026-10-24 改正：以前这条规则没写 dest，放行的是**路由器本身**（管理页、SSH、DNS 全对外），家里设备反而照样进不来——
 *    名不副实还是安全隐患。现在只放行到局域网设备，路由器本身始终受保护。
 * 唯一入口：外网访问 → IPv6 防火墙（web_set_ipv6_fw）。上网设置页里原厂的那个开关已去掉，IPv6 设置不再改它。 */
const IPV6_FW_SEC = 'kel_ipv6_allow';

function ipv6FirewallApply(allowInbound) {
	let c = cfg('firewall');
	/* ⚠️ 判断 section 是否存在也用三参 get：两参 get(conf, sec) 拿不到 section 表 */
	if (c.get('firewall', IPV6_FW_SEC, 'target') == null) {
		c.set('firewall', IPV6_FW_SEC, 'rule');
		c.set('firewall', IPV6_FW_SEC, 'name', 'KEL-Allow-IPv6-WAN');
		c.set('firewall', IPV6_FW_SEC, 'src', 'wan');
		c.set('firewall', IPV6_FW_SEC, 'family', 'ipv6');
		c.set('firewall', IPV6_FW_SEC, 'proto', 'all');
		c.set('firewall', IPV6_FW_SEC, 'target', 'ACCEPT');
	}
	c.set('firewall', IPV6_FW_SEC, 'dest', 'lan');
	c.set('firewall', IPV6_FW_SEC, 'enabled', allowInbound ? '1' : '0');
	c.commit('firewall');
}

/* lan 侧（odhcpd）一趟写全，避免 7 个模式各写一遍还漏项 */
function ipv6LanApply(mode, enabled) {
	let d = cfg('dhcp');
	const RA = 'dhcp.lan.ra';
	const V6 = 'dhcp.lan.dhcpv6';
	/* 先清掉上一次可能留下的、跟本次模式冲突的选项 */
	d.delete('dhcp', 'lan', 'ra_flags');
	d.delete('dhcp', 'lan', 'ra_slaac');
	d.delete('dhcp', 'lan', 'ndp');
	d.delete('dhcp', 'lan', 'master');

	if (!enabled || mode === 'onlyrouter') {
		d.set('dhcp', 'lan', 'ra', 'disabled');
		d.set('dhcp', 'lan', 'dhcpv6', 'disabled');
	} else if (mode === 'relay') {
		d.set('dhcp', 'lan', 'ra', 'relay');
		d.set('dhcp', 'lan', 'dhcpv6', 'relay');
		d.set('dhcp', 'lan', 'ndp', 'relay');
		d.set('dhcp', 'lan', 'master', '1');
		/* 上游那一段也要标成 master + relay，否则 odhcpd 不知道谁转发给谁 */
		if (d.get('dhcp', 'wan6', 'interface') == null) d.set('dhcp', 'wan6', 'dhcp');
		d.set('dhcp', 'wan6', 'interface', 'wan6');
		d.set('dhcp', 'wan6', 'ignore', '1');
		d.set('dhcp', 'wan6', 'master', '1');
		d.set('dhcp', 'wan6', 'ra', 'relay');
		d.set('dhcp', 'wan6', 'dhcpv6', 'relay');
		d.set('dhcp', 'wan6', 'ndp', 'relay');
	} else if (mode === 'slacc') {
		d.set('dhcp', 'lan', 'ra', 'server');
		d.set('dhcp', 'lan', 'ra_slaac', '1');
		d.set('dhcp', 'lan', 'dhcpv6', 'disabled');
	} else {
		d.set('dhcp', 'lan', 'ra', 'server');
		d.set('dhcp', 'lan', 'dhcpv6', 'server');
		if (mode === 'dhcpv6') {
			/* 有状态：M 位置位，逼客户端走 DHCPv6 拿地址 */
			d.set('dhcp', 'lan', 'ra_flags', [ 'managed-config', 'other-config' ]);
			d.set('dhcp','lan','ra_slaac','0');
		} else {
			/* native / nat6：RA + SLAAC，同时下发 other-config */
			d.set('dhcp', 'lan', 'ra_slaac', '1');
			d.set('dhcp', 'lan', 'ra_flags', [ 'managed-config', 'other-config' ]);
		}
	}
	d.commit('dhcp');
}

/* 写：7 个 web_set_ipv6_xxx 共用 */
/* IPv6 上行接口 wan6 跟着上网方式走（OpenWrt 标准接法）：
 *   拨号上网 → wan6 挂在拨号连接上（device '@wan'），并关掉 PPP 自动生成的 wan_6（wan.ipv6='1'）；
 *   其它方式 → wan6 挂物理口，wan.ipv6 删掉（缺省）。
 * 🔴 以前拨号时 wan6 挂在物理口上、一直没启用，实际在用的是 PPP 自动生成的 wan_6——
 *    IPv6 设置页写进 wan6 的东西（自定义 DNS 等）在拨号下全都不生效（2026-10-15 发现）。 */
function wan6Bind(c) {
	if (c.get('network', 'wan6', 'proto') == null) return;
	let pppoe = t(c.get('network', 'wan', 'proto')) === 'pppoe';
	c.set('network', 'wan6', 'device', pppoe ? '@wan' : (t(c.get('network', 'wan', 'device')) || 'wan'));
	if (pppoe) c.set('network', 'wan', 'ipv6', '1'); else c.delete('network', 'wan', 'ipv6');
}

function applyIpv6(a, mode) {
	let enabled = num(a.enabled, 0);
	if (enabled == null) enabled = 0;

	let n = cfg('network');
	wan6Bind(n);

	/* --- WAN6 --- */
	if (!enabled) {
		n.set('network', 'wan6', 'proto', 'none');
		n.delete('network', 'wan6', 'ip6addr');
		n.delete('network', 'wan6', 'ip6gw');
	} else if (mode === 'static') {
		let vip = t(a.wan_ipaddr);
		let gw = t(a.wan_gateway);
		let plen = num(a.lan_prefix_len, 64);
		if (plen == null || plen <= 0 || plen > 128) plen = 64;
		n.set('network', 'wan6', 'proto', 'static');
		if (vip !== '')
			n.set('network', 'wan6', 'ip6addr', [ (v6Plen(vip) !== '') ? vip : (vip + '/' + plen) ]);
		if (gw !== '') n.set('network', 'wan6', 'ip6gw', gw);
	} else {
		n.set('network', 'wan6', 'proto', 'dhcpv6');
		n.delete('network', 'wan6', 'ip6addr');
		n.delete('network', 'wan6', 'ip6gw');
	}

	/* --- IPv6 DNS --- */
	if (enabled && num(a.dns_enabled, 0) === 1) {
		let list = [];
		let d1 = t(a.dns1), d2 = t(a.dns2);
		if (d1 !== '') push(list, d1);
		if (d2 !== '') push(list, d2);
		if (length(list) > 0) {
			n.set('network', 'wan6', 'peerdns', '0');
			n.set('network', 'wan6', 'dns', list);
		} else {
			n.set('network', 'wan6', 'peerdns', '1');
			n.delete('network', 'wan6', 'dns');
		}
	} else {
		n.delete('network', 'wan6', 'dns');
		n.set('network', 'wan6', 'peerdns', '1');
	}

	/* --- 静态模式下的 LAN 前缀 --- */
	if (enabled && mode === 'static') {
		let lp = t(a.lan_prefix);
		let len = num(a.lan_prefix_len, 64);
		if (len == null || len <= 0 || len > 128) len = 64;
		if (lp !== '') {
			n.set('network', 'lan', 'ip6addr', [ (v6Plen(lp) !== '') ? lp : (lp + '/' + len) ]);
			n.delete('network', 'lan', 'ip6assign');
		}
	} else {
		n.delete('network', 'lan', 'ip6addr');
		n.set('network', 'lan', 'ip6assign', '60');
	}

	n.commit('network');

	/* --- LAN / odhcpd --- */
	ipv6LanApply(mode, enabled);

	/* --- firewall：nat6 的 masq6 + IPv6 入站放行开关 --- */
	let f = cfg('firewall');
	if (enabled && mode === 'nat6') fwWanSet(f, 'masq6', '1');
	else fwWanDel(f, 'masq6');
	f.commit('firewall');
	/* fw_enable 不再在这里处理：总开关的唯一入口是 IPv6 防火墙页（原厂页面那一行已去掉，它再传上来的值是缺省值，不能当真） */

	/* 记一份模式，供读的时候消歧 */


	netReload();
	odhcpdReload();
	fwReload();
	return { status: 0 };
}

/* 读：以 kel 里记的模式为准，没有记录才按 uci 反推 */
function ipv6Read() {
	let n = cfg('network');
	let w6 = t(n.get('network', 'wan6', 'proto'));
	let enabled = (w6 !== '' && w6 !== 'none') ? 1 : 0;

	let d = cfg('dhcp');
	let lanv6 = t(d.get('dhcp', 'lan', 'dhcpv6'));
	let lanra = t(d.get('dhcp', 'lan', 'ra'));

	let ty='native';
	if(w6==='static')ty='static';
	else if(lanv6==='relay'||lanra==='relay')ty='relay';
	else if(lanra==='disabled'&&lanv6==='disabled')ty='onlyrouter';
	else if(t(fwWanGet(cfg('firewall'),'masq6'))==='1')ty='nat6';
	else if(lanra==='server'&&lanv6==='disabled')ty='slacc';
	else if(t(d.get('dhcp','lan','ra_slaac'))==='0'&&lanv6==='server')ty='dhcpv6';

	/* DNS */
	let peer = t(n.get('network', 'wan6', 'peerdns'));
	let dv = n.get('network', 'wan6', 'dns');
	let d1 = '', d2 = '';
	if (type(dv) === 'array') {
		if (length(dv) > 0) d1 = '' + dv[0];
		if (length(dv) > 1) d2 = '' + dv[1];
	} else if (dv != null && dv !== '') {
		d1 = t(dv);
	}
	let dns_enabled = (peer === '0' && (d1 !== '' || d2 !== '')) ? 1 : 0;

	/* 静态模式的地址 */
	let ip6 = n.get('network', 'wan6', 'ip6addr');
	let wan_ipaddr = '';
	if (type(ip6) === 'array' && length(ip6) > 0) wan_ipaddr = bareV6('' + ip6[0]);
	else if (ip6 != null && ip6 !== '') wan_ipaddr = bareV6(t(ip6));

	let lan6 = n.get('network', 'lan', 'ip6addr');
	let lan_prefix = '', prefix_len = '';
	if (type(lan6) === 'array' && length(lan6) > 0) {
		lan_prefix = bareV6('' + lan6[0]);
		prefix_len = v6Plen('' + lan6[0]);
	} else if (lan6 != null && lan6 !== '') {
		lan_prefix = bareV6(t(lan6));
		prefix_len = v6Plen(t(lan6));
	}
	if (prefix_len === '') prefix_len = t(n.get('network', 'lan', 'ip6assign'));

	/* IPv6 防火墙：没规则或规则被禁用 = 防火墙开着
	   ⚠️ 必须用**三参** get(conf, sec, opt)。实测两参的 get(conf, sec)
	      不返回 section 表，拿到的不是对象，接着做 `.enabled` 会抛
	      「left-hand side expression is not an array or object」。 */
	let fc = cfg('firewall');
	let ruleOn = t(fc.get('firewall', IPV6_FW_SEC, 'enabled'));
	let fw_enable = (ruleOn === '1') ? 0 : 1;

	return {
		enabled: enabled,
		type: ty,
		dns_enabled: dns_enabled,
		dns1: d1,
		dns2: d2,
		fw_enable: fw_enable,
		wan_ipaddr: wan_ipaddr,
		wan_gateway: t(n.get('network', 'wan6', 'ip6gw')),
		lan_prefix: lan_prefix,
		prefix_len: num(prefix_len, 0)
	};
}

