	/* 网口设置：{ port: "lan1"|"wan"…(物理口), role: "wan"|"lan"|"guest"|"off", speed: "auto"|"100"|"10", client_mac }
	   role=wan：把上网口指派到该物理口（network.wan / wan6 的 device 改过去）。
	     🔴 原来的上网口改成「关闭」而不是并进局域网 —— 光猫网线若还插在旧口上，
	        并进 br-lan 就会把光猫的二层桥进家里（双 DHCP 抢地址，09-27 上午的事故形态）。
	        网线挪好后用户再把旧口设成局域网。
	   返回码：1 参数错 / 2 当前上网口只能通过「把别的口设为 WAN」来改 / 3 你正通过这个网口连接
	           4 访客网段建立失败 / 5 至少要保留一个局域网口 */
	set_wire_port: {
		call: function (req) {
			let a = req.args ?? {};
			let dev = t(a.port), role = t(a.role), speed = t(a.speed);
			let phys = physPorts();
			if (index(phys, dev) < 0) return { status: 1 };
			if (role !== '' && index([ 'wan', 'lan', 'guest', 'off' ], role) < 0) return { status: 1 };
			if (speed !== '' && index([ 'auto', '100', '10' ], speed) < 0) return { status: 1 };
			let c = cfg('network');
			let curWan = t(c.get('network', 'wan', 'device'));
			let ls = bridgeSid(c, 'br-lan');
			let lp = listOpt(c.get('network', ls, 'ports'));
			let gs = bridgeSid(c, 'br-guest');
			let gp = (gs != null) ? listOpt(c.get('network', gs, 'ports')) : [];
			if (dev === curWan && role !== '' && role !== 'wan') return { status: 2 };
			if (role !== '' && role !== 'lan' && dev !== curWan && brPortOfMac('br-lan', t(a.client_mac)) === dev)
				return { status: 3 };
			/* 改完之后 br-lan 里至少还得有一个真实物理口，否则只剩无线能进管理页 */
			if (role !== '' && role !== 'lan' && dev !== curWan) {
				let remain = filter(lp, (x) => x !== dev && access('/sys/class/net/' + x));
				if (length(remain) === 0) return { status: 5 };
			}
			if (role === 'guest' && !guestNetReady()) {
				if (!ensureGuestNet()) return { status: 4 };
				c = cfg('network');
				gs = bridgeSid(c, 'br-guest');
				gp = (gs != null) ? listOpt(c.get('network', gs, 'ports')) : [];
			}
			if (role !== '' && !(role === 'wan' && dev === curWan)) {
				lp = filter(lp, (x) => x !== dev);
				gp = filter(gp, (x) => x !== dev);
				if (role === 'lan') push(lp, dev);
				if (role === 'guest') push(gp, dev);
				if (role === 'wan') {
					/* 旧上网口 → 关闭（不进任何网桥） */
					c.set('network', 'wan', 'device', dev);
					if (c.get_all('network', 'wan6') && t(c.get('network', 'wan6', 'device')) === curWan)
						c.set('network', 'wan6', 'device', dev);
				}
				c.set('network', ls, 'ports', lp);
				if (gs != null) {
					if (length(gp) > 0) c.set('network', gs, 'ports', gp);
					else c.delete('network', gs, 'ports');
				}
			}
			if (speed !== '') {
				let ds = portDevSid(c, dev, speed !== 'auto');
				if (ds != null) {
					if (speed === 'auto') {
						c.delete('network', ds, 'speed');
						c.delete('network', ds, 'duplex');
						/* 只剩 name 的空段删掉，配置保持干净 */
						let left = filter(keys(c.get_all('network', ds) ?? {}), (k) => substr(k, 0, 1) !== '.' && k !== 'name');
						if (length(left) === 0) c.delete('network', ds);
					}
					else { c.set('network', ds, 'speed', speed); c.set('network', ds, 'duplex', 'full'); }
				}
			}
			c.commit('network');
			sh('ubus call network reload');
			return { status: 0 };
		}
	},


};

