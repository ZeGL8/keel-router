			c.set('firewall','kel_macfilter_rule','rule');c.set('firewall','kel_macfilter_rule','name','KEL-MAC-'+(policy==='allow'?'Whitelist':'Blacklist'));
			c.set('firewall','kel_macfilter_rule','src','*');c.set('firewall','kel_macfilter_rule','dest','*');c.set('firewall','kel_macfilter_rule','proto','all');
			c.set('firewall','kel_macfilter_rule','family','any');c.set('firewall','kel_macfilter_rule','target','DROP');
