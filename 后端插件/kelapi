}
/* 太笼统、不足以当名字用的主机名：有 mDNS 真名时优先真名 */
function hostGeneric(h) {
	h = lc('' + h);
	return (h === '' || match(h, /^(iphone|ipad|mac|macbook|android|localhost|unknown|dhcp|host|pc|espressif)(-[0-9a-f]+)?$/) != null ||
		match(h, /^android-[0-9a-f]{8,}$/) != null);
}
/* DHCP 指纹（hotplug 在新租约时记到 /tmp/kel_dhcpfp/<mac>）→ 设备类型 + 说明 */
function fpGuess(mac) {
	let txt = rf('/tmp/kel_dhcpfp/' + lc(normMac(mac)));
	if (txt === '') return null;
	let vendor = '', opts = '';
	for (let ln in splitLines(txt)) {
		let m = match(trim('' + ln), /^([a-z]+)=(.*)$/);
		if (m == null) continue;
		if (m[1] === 'vendor') vendor = m[2]; else if (m[1] === 'opts') opts = m[2];
	}
	if (match(vendor, /android/i) != null) return { kind: 'phone', label: '安卓设备' };
	if (match(vendor, /^MSFT/) != null) return { kind: 'pc', label: 'Windows 电脑' };
	if (match(opts, /^1,121,3,6,15,119,252/) != null) return { kind: '', label: '苹果设备' };
	if (match(opts, /(^|,)249(,|$)/) != null && match(opts, /(^|,)252(,|$)/) != null) return { kind: 'pc', label: 'Windows 电脑' };
	if (match(opts, /^1,3,6,15,26,28,51,58,59,43/) != null) return { kind: 'phone', label: '安卓设备' };
	if (match(vendor, /(udhcp|dhcpcd|linux)/i) != null) return { kind: '', label: 'Linux 设备' };
	return null;
}

/* mDNS 学习：从 umdns 缓存取「IP → 真名/型号」，按 ARP 对应到 MAC，存下来。
   umdns 是独立进程（不是 rpcd 自己的对象），调用不会死锁；每 60 秒最多学一次，每 5 分钟主动问一轮常见服务。 */
const MDNS_PRIO = { '_companion-link._tcp': 1, '_airplay._tcp': 2, '_googlecast._tcp': 2, '_hap._tcp': 3, '_ipp._tcp': 3,
	'_printer._tcp': 3, '_workstation._tcp': 4, '_device-info._tcp': 4, '_smb._tcp': 5, '_miio._udp': 5, '_raop._tcp': 6 };
function mdnsClean(nm) {
	nm = replace('' + nm, /^[0-9A-Fa-f]{12}@/, '');
	nm = replace(nm, /\s*\([0-9]+\)$/, '');
	return trim(nm);
}
function mdnsHuman(nm) {
	return (nm !== '' && match(nm, /^[0-9A-Fa-f:. -]{8,}$/) == null && match(nm, /@/) == null && length(nm) <= 48);
}
/* LAN 邻居地址与识别展示，读取不修改网络配置。 */
function deviceIpv6Neighbors() {
	let out = {}, allowed = [ 'br-lan', 'br-guest' ];
	let c = cfg('network');
	for (let section in [ 'lan', 'guest' ]) for (let dev in listOpt(c.get('network', section, 'device')))
		if (index(allowed, dev) < 0) push(allowed, dev);
	for (let line in splitLines(sh('ip -6 neigh show'))) {
		let f = split(trim(line), /\s+/), di = index(f, 'dev'), mi = index(f, 'lladdr');
		if (di < 0 || mi < 0 || index(allowed, f[di + 1]) < 0 || index(f, 'FAILED') >= 0 || index(f, 'INCOMPLETE') >= 0) continue;
		let mac = uc(normMac(f[mi + 1]));
		if (mac === '' || match(f[0], /^ff/i)) continue;
		let state = 'UNKNOWN';
		for (let v in [ 'REACHABLE', 'STALE', 'DELAY', 'PROBE', 'PERMANENT', 'NOARP' ]) if (index(f, v) >= 0) state = v;
		let scope = match(f[0], /^fe[89ab]/i) ? 'link' : match(f[0], /^f[cd]/i) ? 'ula' : 'global';
		out[mac] ||= [];
		push(out[mac], { address: f[0], scope: scope, state: state, interface: f[di + 1] });
	}
	return out;
}

function mdnsLearn() {
	if (!access('/usr/sbin/umdns')) return;
	let now = time();
	if (now - int(rf('/tmp/.kel_mdns_ts') || '0') < 60) return;
	wf('/tmp/.kel_mdns_ts', '' + now);
	if (now - int(rf('/tmp/.kel_mdns_q') || '0') >= 300) {
		wf('/tmp/.kel_mdns_q', '' + now);
		let qs = [];
		for (let q in [ '_companion-link._tcp', '_airplay._tcp', '_googlecast._tcp', '_hap._tcp', '_ipp._tcp', '_miio._udp', '_workstation._tcp', '_services._dns-sd._udp' ])
			push(qs, "ubus -t 2 call umdns query '{\"question\":\"" + q + ".local\",\"interface\":\"br-lan\",\"type\":12}' >/dev/null 2>&1");
		sh('(' + join('; ', qs) + ') >/dev/null 2>&1 &');
	}
	let j = null;
	try { j = json(sh("ubus -t 4 call umdns browse '{\"array\":true}' 2>/dev/null")); } catch (e) { j = null; }
	if (j == null) return;
	let arp = arpTable(), ip2mac = {};
	for (let m in keys(arp)) if (arp[m].dev === 'br-lan' || arp[m].dev === 'br-guest') ip2mac[arp[m].ip] = m;
	let v6 = deviceIpv6Neighbors();
	for (let m in keys(v6)) for (let n in v6[m]) ip2mac[n.address] = m;
	let best = {};		/* ip → { prio, name, model, kind } */
	for (let svc in keys(j)) {
		let pr = MDNS_PRIO[svc] ?? 9;
		for (let inst in keys(j[svc])) {
			let e = j[svc][inst];
			let txt = {};
			for (let kv in (e.txt ?? [])) { let m = match('' + kv, /^([^=]+)=(.*)$/); if (m != null) txt[lc(m[1])] = m[2]; }
			let nm = (svc === '_googlecast._tcp' && txt.fn) ? txt.fn : mdnsClean(inst);
			if (!mdnsHuman(nm)) nm = trim(replace(replace('' + (e.host ?? ''), /\.local\.?$/, ''), '-', ' '));
			if (!mdnsHuman(nm)) continue;
			let model = txt.model ?? txt.am ?? txt.md ?? txt.ty ?? '';
			let kind = kindFromModel(model);
			if (kind === '') {
				if (svc === '_googlecast._tcp') kind = match(model, /(Home|Nest|Speaker|Audio)/i) ? 'speaker' : 'tv';
				else if (svc === '_ipp._tcp' || svc === '_printer._tcp') kind = 'printer';
				else if (svc === '_hap._tcp' || svc === '_miio._udp') kind = 'iot';
				else if (svc === '_workstation._tcp') kind = 'pc';
			}
			for (let ip in [ ...(e.ipv4 ?? []), ...(e.ipv6 ?? []) ]) {
				let b = best[ip];
				if (b == null || pr < b.prio) best[ip] = { prio: pr, name: nm, model: model, kind: kind };
