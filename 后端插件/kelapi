					for (let k in SVC_KEYS) if (out.svc[k] !== 'follow') {
						let nw = all[SVC_GROUP[k] + '-选择']?.now ?? '';
						out.svc_now[k] = (nw === 'COMPATIBLE') ? '' : nw;	/* COMPATIBLE = 组里还没有测通的节点 */
					}
				}
				if (pv != null) {
					out.updated_at = pv.updatedAt ?? '';
					let si = pv.subscriptionInfo;
					if (si != null && (si.Total ?? 0) > 0)
						out.traffic = { used: (si.Upload ?? 0) + (si.Download ?? 0), total: si.Total, expire: si.Expire ?? 0 };
					for (let d in (pv.proxies ?? [])) {
						let h = d.history ?? [];
						if (length(h) === 0 && d.extra != null)
							for (let k in keys(d.extra)) { h = d.extra[k]?.history ?? []; break; }
						let delay = (length(h) > 0) ? (h[length(h) - 1].delay ?? 0) : 0;
						let at = 0;
						if (length(h) > 0) {
							let tm = match('' + (h[length(h) - 1].time ?? ''), /^([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})/);
							if (tm != null) at = timegm({ year: +tm[1], mon: +tm[2], mday: +tm[3], hour: +tm[4], min: +tm[5], sec: +tm[6] });
						}
						push(out.nodes, { name: d.name ?? '', type: d.type ?? '', delay: delay, tested: length(h) > 0, at: at });
					}
