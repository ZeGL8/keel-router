	web_config_ddns: {
		call: function (req) {
			let a = req.args ?? {};
			let name = t(a.ddns_name);
			if (name === '') return { status: 1, error: 'ddns_name required' };
			let action = num(a.action, 1);
			ddnsConfPath();
			let slug = ddnsSlug(name);

			if (action === 0) {
				/* action=0：移除该 DDNS 服务。
				   ⚠️ 先停该段的 updater 再删配置：旧实现只删 uci，已在跑的 updater
				   进程继续按旧参数更新解析，直到重启才消失。 */
				let rs = ddnsSectionFor(name);
				sh('/usr/lib/ddns/dynamic_dns_lucihelper.sh -S ' + rs + ' -- stop >/dev/null 2>&1');
				sh('uci -q delete ddns.' + rs);
				sh('uci commit ddns');
				ddnsRestart();
				return { status: 0 };
			}

			/* action=1：新增/编辑。先用 CLI 建命名 section（slug 仅含
			   [A-Za-z0-9_]，拼接安全），再用 cursor.set 写各选项（转义安全）。 */
			sh('uci -q set ddns.' + slug + '=service');
			sh('uci commit ddns');
			let c = cfg('ddns');
			c.set('ddns', slug, 'kel_name', name);
			c.set('ddns', slug, 'enabled', '1');
			let svc = ddnsSvcIn(a.service);
			if (!access('/usr/share/ddns/default/' + svc + '.json'))
				return { status: 1, error: 'ddns service not installed: ' + svc };
			c.set('ddns', slug, 'service_name', svc);
			c.set('ddns', slug, 'domain', t(a.domain));
			c.set('ddns', slug, 'username', t(a.username));
			if (t(a.passwd) !== DDNS_PW_KEEP) c.set('ddns', slug, 'password', t(a.passwd));
			c.set('ddns', slug, 'check_interval', t(a.check_interval));
			c.set('ddns', slug, 'force_interval', t(a.force_interval));
			c.set('ddns', slug, 'interface', 'wan');
			/* 🔴 WAN 是私网地址（上游光猫/运营商 NAT 后面）时，按网口取 IP 永远是
			   私网地址，ddns-scripts 默认 upd_privateip=0 直接不更新 → DDNS 永远不生效。
			   这种情况改用 ddns-scripts 的 web 探测公网 IP。 */
			if (isPrivIPv4(ddnsWanIP())) {
				c.set('ddns', slug, 'ip_source', 'web');
				c.set('ddns', slug, 'ip_url', 'http://ip.3322.net');
				c.delete('ddns', slug, 'ip_network');
			} else {
				c.set('ddns', slug, 'ip_source', 'network');
				c.set('ddns', slug, 'ip_network', 'wan');
				c.delete('ddns', slug, 'ip_url');
			}
			c.set('ddns', slug, 'use_ipv6', '0');
			c.set('ddns', slug, 'check_unit', 'minutes');
			c.set('ddns', slug, 'force_unit', 'minutes');
			c.commit('ddns');

			ddnsRestart();
			return { status: 0 };
		}
	},

