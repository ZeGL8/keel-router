	/* 网口信息（PC/seniorManagement/HighSetting.html「网口自定义」页）2026-09-27 实现。
	   🔴 原厂该页在本机上只显示 IPTV 块；IPTV（原厂专有）裁掉后整页**空白**。
	   网口状态本身是 OpenWrt 原生可得的：端口列表取 uci（br-lan 的 ports +
	   network.wan.device，不写死），每口状态取 netifd（network.device status：
	   present / carrier / speed "1000F"）。board.json 里有的口硬件未必有
	   （本机 lan4 不存在）→ 只报 netifd 认为 present 的口。
	   前端契约：wan_lan_info[{ sp_name: "wan"|"1".."4", duplex_speed: N }]，
	   N 的二进制前三位 = 速率档（000 断开 / 001 10M / 010 100M / 011 1G / 100 2.5G），
	   末位 = 全双工。 */
	get_wire_ports_info: {
		call: function () {
			let st = null;
			try { st = json(sh('ubus call network.device status')); } catch (e) { st = null; }
			if (type(st) !== 'object') return { wan_lan_info: [], status: 1 };
			let c = cfg('network');
			let lanPorts = listOpt(c.get('network', bridgeSid(c, 'br-lan') ?? '-', 'ports'));
			let gSid = bridgeSid(c, 'br-guest');
			let guestPorts = (gSid != null) ? listOpt(c.get('network', gSid, 'ports')) : [];
			let wdev = t(c.get('network', 'wan', 'device'));
			let ports = [];
			for (let d in physPorts()) push(ports, { dev: d, sp: portLabel(d) });
			let out = [];
			for (let p in ports) {
				let d = st[p.dev];
				if (d == null || d.present === false) continue;
				let code = 0;
				if (d.carrier) {
					let m = match('' + (d.speed ?? ''), /^([0-9]+)([FH]?)$/);
					let mb = (m != null) ? int(m[1]) : 0;
					let cls = (mb >= 2500) ? 4 : (mb >= 1000) ? 3 : (mb >= 100) ? 2 : (mb >= 10) ? 1 : 0;
					code = cls * 2 + ((m != null && m[2] === 'F') ? 1 : 0);
				}
				let role = (p.dev === wdev) ? 'wan'
					: (index(lanPorts, p.dev) >= 0) ? 'lan'
					: (index(guestPorts, p.dev) >= 0) ? 'guest' : 'off';
				let ds = portDevSid(c, p.dev, false);
				let spd = (ds != null) ? t(c.get('network', ds, 'speed')) : '';
				push(out, { sp_name: p.sp, duplex_speed: code, ifname: p.dev,
					carrier: d.carrier ? 1 : 0, link: t(d.speed),
					role: role, speed_cfg: (spd === '') ? 'auto' : spd });
			}
			return { wan_lan_info: out, status: 0 };
		}
	},

	/* 按设备 IPv6 开关（设备列表页，Public_JS/kel-ipv6.js）
	   get → { blocked: [MAC…] }（大写冒号格式，与设备列表 id 一致）
	   set ← { uid: MAC（带不带冒号都行）, enable: "1" 开 / "0" 关 } */
	/* 设备识别信息（给设备列表的「类型/来源」标签用）：{ list:[{ id, kind, kind_zh, src, random, model }] } */
	web_get_device_kinds: {
		call: function () {
			mdnsLearn();
			let ls = dhcpLeases(), arp = arpTable(), seen = {}, out = [];
			let add = function (mac, hn) {
				mac = uc(normMac(mac)); if (mac === '' || seen[mac]) return; seen[mac] = 1;
				let dr = devResolve(mac, hn);
				let al = qosGet(mac, 'name', '');
				push(out, { id: mac, kind: dr.kind ?? '', kind_zh: KIND_ZH[dr.kind ?? ''] ?? '', src: (al !== '') ? 'alias' : dr.src, random: dr.random, model: dr.model ?? '' });
			};
			for (let m in keys(ls)) add(m, ls[m].name);
			/* ARP 里只要局域网侧（br-lan/br-guest）且有效的条目：上级网络设备（dev=wan）和全 0 的未完成条目不算「连着路由器的设备」 */
			for (let m in keys(arp)) {
				if ((arp[m].dev === 'br-lan' || arp[m].dev === 'br-guest') && arp[m].flags !== '0x0' && m !== '00:00:00:00:00:00') add(m, '');
			}
			return { status: 0, list: out };
		}
	},

