	/* 实时流量：/proc/net/dev 采样 + 5 分钟桶（288 桶 = 24h）
	   ⚠️ 前端契约（routerStatus.js 实证，2026-09-23）：
	     · yAxis name 是 **Mbps** —— 必须按 Mbps 返回（旧实现是 MB/s，小 8 倍，
	       两位小数四舍五入后整张图几乎全是 0.00，用户看到的"没数据"）
	     · 288 个点，x 轴按"从当前时间往前每 5 分钟"打标签 ⇒ 后端必须给出
	       以当前 5 分钟桶结尾、严格 5 分钟间隔的 288 个值，历史缺失补 0
	     · 只有打开页面时采样 ⇒ 大部分点被补 0；靠 ensureFlowCron() 的
	       cron 每 5 分钟后台采样填满 */
	web_get_network_flow: {
		call: function () {
			const FILE = '/tmp/.kel_flow.json';
			const N = 288;      /* 24h @ 5min */
			const STEP = 300;

			ensureFlowCron();

			let st = null;
			try { st = json(rf(FILE)); } catch (e) { st = null; }
			if (type(st) !== 'object' || st == null) st = {};
			if (type(st.b) !== 'array') st.b = [];
			let last = (type(st.s) === 'object') ? st.s : null;

			/* 采样上行计数（中继模式=wwan 设备，见 uplinkDev） */
			let wan = uplinkDev();
			let rx = 0, tx = 0, found = false;
			for (let line in splitLines(rf('/proc/net/dev'))) {
				let p = index('' + line, ':');
				if (p < 0) continue;
				if (trim(substr('' + line, 0, p)) !== wan) continue;
				let f = split(trim(substr('' + line, p + 1)), /\s+/);
				if (!f || length(f) < 9) continue;
				rx = num(f[0]) ?? 0;
				tx = num(f[8]) ?? 0;
				found = true;
			}
			let now = 0;
			let u = split(t(rf('/proc/uptime')), ' ');
			if (u && u[0]) now = num(u[0]) ?? 0;

			let epoch = time();
			let bucket = int(epoch / STEP) * STEP;

			/* 把本次区间累加进当前 5 分钟桶。
			   桶里存的是【字节数 + 秒数】而不是瞬时速率，输出时才算 Σbytes×8/Σsec/1e6
			   —— 这样分钟级采样不会因为「采样点刚好落在空闲瞬间」而把真实流量抹掉。 */
			if (found && last != null) {
				let dt = now - last.t;
				if (dt > 0 && dt <= 900) {
					/* ⚠️⚠️ ucode 的 `/` 在两个**整数**之间是整数除法（向零截断）：
					   `int*8/dt/1000000` 会先算出 196194 再被 1000000 除成 **0**，
					   于是图表永远是一条贴底直线（真机实测踩过）。
					   算速率时必须用浮点字面量（×8.0 / ×1.0）把整条链拉进浮点域。 */
					let sb = st.b;
					let bi = -1;
					for (let i = 0; i < length(sb); i++)
						if (sb[i].t === bucket) { bi = i; break; }
					if (bi < 0) {
						push(sb, { t: bucket, bup: 0, bdn: 0, sec: 0 });
						bi = length(sb) - 1;
					}
					sb[bi].bup = num(sb[bi].bup, 0) + fmax(0, tx - last.tx);
					sb[bi].bdn = num(sb[bi].bdn, 0) + fmax(0, rx - last.rx);
					sb[bi].sec = num(sb[bi].sec, 0) + dt;
				}
			}
			if (found) st.s = { t: now, rx: rx, tx: tx };

			/* 对齐输出：以当前桶结尾、严格 5 分钟间隔的 N 个值 */
			let start = bucket - (N - 1) * STEP;
			let out = [];
			for (let i = 0; i < N; i++) {
				let bt = start + i * STEP;
				let b = null;
				for (let x in st.b) if (x.t === bt) { b = x; break; }
				let sec = (b != null) ? num(b.sec, 0) : 0;
				if (b == null || !(sec > 0)) {
					push(out, [ '0.00', '0.00' ]);
					continue;
				}
				let up = num(b.bup, 0) * 8.0 / (sec * 1.0) / 1000000.0;
				let dn = num(b.bdn, 0) * 8.0 / (sec * 1.0) / 1000000.0;
				push(out, [ sprintf('%.2f', up), sprintf('%.2f', dn) ]);
			}

			/* 只保留窗口内的桶 */
			let keep = [];
			for (let b in st.b) if (b.t >= start) push(keep, b);
			st.b = keep;
			wf(FILE, sprintf('%J', st));

			return { data: out, status: 0 };
		}
	},

