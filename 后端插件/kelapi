	/* 选节点：{ name } —— 必须是「代理」组里真实存在的节点名（防注入），选中后记入 uci 以便重启恢复。
	   返回码：1 未运行 / 2 参数错 / 3 节点不存在 / 4 切换失败 */
	web_clash_select: {
		call: function (req) {
			let name = t(req.args?.name);
			let secret = t(cfg('kelclash').get('kelclash', 'main', 'secret'));
			if (name === '' || length(name) > 200) return { status: 2 };
			if (match(secret, /^[0-9a-f]{16,64}$/) == null) return { status: 1 };
			let hdr = "-H 'Authorization: Bearer " + secret + "'";
			let px = null;
			try { px = json(sh('curl -s -m4 ' + hdr + ' http://127.0.0.1:9090/proxies/%E4%BB%A3%E7%90%86')); } catch (e) { px = null; }
			if (px == null) return { status: 1 };
			if (index(px.all ?? [], name) < 0) return { status: 3 };
			/* 和守护进程自动切换走同一个函数（run.sh select）：mihomo 里实际用的、uci 里记的、页面显示的三者一致 */
			if (trim(sh("/usr/share/kelclash/run.sh select '" + replace(name, "'", "'\\''") + "' >/dev/null 2>&1; echo $?")) !== '0') return { status: 4 };
			return { status: 0 };
		}
	},

	/* 触发整个订阅的节点测速（mihomo 自己并发，几秒内完成），立即返回；页面轮询 web_get_clash，
	   看每个节点的 at（最近一次测速时间戳）是否 >= 返回的 now 来判断谁测完了。target 仅满足「写方法不许空参数」。 */
	web_clash_testall: {
		call: function (req) {
			let sec = mihomoSecret();
			if (sec == null) return { status: 1 };
			sh("(curl -s -m25 -o /dev/null -H 'Authorization: Bearer " + sec + "' 'http://127.0.0.1:9090/providers/proxies/sub/healthcheck' >/dev/null 2>&1 &)");
			return { status: 0, now: time() };
		}
	},

