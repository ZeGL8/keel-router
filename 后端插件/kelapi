	web_get_custom_hosts: {
		call: function () { return { hosts: trim(rf(CUSTOM_HOSTS)), status: 0 }; }
	},

	web_set_custom_hosts: {
		call: function (req) {
			/* 🔴 旧实现只写了 /etc/kel_hosts，dnsmasq 根本不读它 —— 页面显示
			   「配置成功」但一条都不生效（假功能）。
			   OpenWrt 原生做法：uci dhcp.@dnsmasq[].addnhosts 列表挂上这个文件，
			   dnsmasq init 会生成 addn-hosts=，reload 时 HUP 重读。
			   坏行/缺文件 dnsmasq 只告警不致命（dnsmasq --test 实测），
			   这里仍先校验，给前端明确的失败而不是静默忽略。 */
			let raw = replace('' + (req.args.hosts ?? ''), /\r/g, '');
			if (length(raw) > 8192) return { status: 1, error: 'too long' };
			let out = [];
			for (let ln in split(raw, '\n')) {
				ln = trim(ln);
				if (ln === '' || substr(ln, 0, 1) === '#') { push(out, ln); continue; }
				let f = split(replace(ln, /[ \t]+/g, ' '), ' ');
				if (length(f) < 2) return { status: 1, error: 'bad line: ' + ln };
				if (!isIPv4(f[0]) && !match(f[0], /^[0-9A-Fa-f:.]+$/))
					return { status: 1, error: 'bad address: ' + f[0] };
				if (isIPv4(f[0]) && ip4int(f[0]) == null)
					return { status: 1, error: 'bad address: ' + f[0] };
				for (let i = 1; i < length(f); i++)
					if (!match(f[i], /^[A-Za-z0-9_]([A-Za-z0-9._-]*[A-Za-z0-9])?$/))
						return { status: 1, error: 'bad name: ' + f[i] };
				push(out, join(' ', f));
			}
			if (!wf(CUSTOM_HOSTS, join('\n', out) + '\n')) return { status: 1 };

			let c = cfg('dhcp');
			let sid = null;
			c.foreach('dhcp', 'dnsmasq', function (s) { if (sid == null) sid = s['.name']; });
			if (sid == null) return { status: 1, error: 'no dnsmasq section' };
			let lst = c.get('dhcp', sid, 'addnhosts');
			if (lst == null) lst = [];
			if (type(lst) !== 'array') lst = [ lst ];
			if (index(lst, CUSTOM_HOSTS) < 0) {
				/* 首次挂载：配置变了（多一个 jail 挂载点）→ 必须 restart */
				push(lst, CUSTOM_HOSTS);
				c.set('dhcp', sid, 'addnhosts', lst);
				c.commit('dhcp');
				dnsmasqRestart();
			} else {
				/* 配置没变，只是文件内容变了 → 纯 HUP 重读，不重启、不断 DNS。
				   ⚠️ 仅当 dnsmasq 已稳定运行 ≥10s 才 HUP：连点两次保存时，第二次 HUP
				   可能打在刚被 restart、尚未装好信号处理的 dnsmasq 上（启动瞬间 HUP 必死，
				   见 dnsmasqRestart 注释）。起不久/没在跑 → 改用 restart。 */
				if (dnsmasqSteady()) sh('/etc/init.d/dnsmasq reload >/dev/null 2>&1');
				else dnsmasqRestart();
			}
			return { status: 0 };
		}
	},

