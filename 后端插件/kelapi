				/* 防火墙里的接管规则是否已经是「当前设置」对应的那份（改完范围/IPv6 后守护要十来秒才换上） */
				synced: st?.synced ?? 1,
				phase: trim(split(rf('/tmp/kelclash/phase') ?? '', '\n')[0] ?? ''),
				phase_msg: trim(split(rf('/tmp/kelclash/phase') ?? '', '\n')[1] ?? ''),
