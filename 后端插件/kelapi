	web_set_wds_config: {
		/* 前端上网设置只传 {enable, ssid, encryption, key, channel}（band 基本不传），
		   channel>14 即 5G：按频道定射频，并把本机同射频 AP 的信道对齐上游
		   （同一射频 AP+STA 必须同信道，否则关联不上/反复掉线）。 */
		call: function (req) {
			let a = req.args ?? {};
			let en = (t(a.enable) === '1' || t(a.enabled) === '1');
			let c = cfg('wireless');
			if (!en) {
				if (c.get_all('wireless', 'wwan')) {
					c.set('wireless', 'wwan', 'disabled', '1');
					c.commit('wireless');
					wifiReload();
				}
				return { status: 1 };
			}
			let ch = num(a.channel, 0);
			let radio;
			if (ch > 14) radio = 'radio1';
			else if (ch >= 1 && ch <= 14) radio = 'radio0';
			else radio = (t(a.band) === '1') ? 'radio1' : 'radio0';
			if (!c.get_all('wireless', 'wwan')) c.set('wireless', 'wwan', 'wifi-iface');
			c.set('wireless', 'wwan', 'device', radio);
			c.set('wireless', 'wwan', 'mode', 'sta');
			c.set('wireless', 'wwan', 'network', 'wwan');
			c.set('wireless', 'wwan', 'disabled', '0');
			if (a.ssid != null) c.set('wireless', 'wwan', 'ssid', t(a.ssid));
			c.set('wireless', 'wwan', 'encryption', encDesc2Ow(a.encryption));
			if (a.key != null) c.set('wireless', 'wwan', 'key', t(a.key));
			if (ch >= 1 && ch <= 14 && c.get_all('wireless', 'radio0'))
				c.set('wireless', 'radio0', 'channel', '' + ch);
			if (ch > 14 && c.get_all('wireless', 'radio1'))
				c.set('wireless', 'radio1', 'channel', '' + ch);
			c.commit('wireless');
			/* wwan 三层接口缺失则补建（DHCP 客户端），防止恢复出厂后静默失败 */
			let nc = cfg('network');
			let haveWwan = false;
			nc.foreach('network', 'interface', function (s) { if (s['.name'] === 'wwan') haveWwan = true; });
			if (!haveWwan) {
				nc.set('network', 'wwan', 'interface');
				nc.set('network', 'wwan', 'proto', 'dhcp');
				nc.commit('network');
				netReload();
			}
			/* wan 防火墙区需包含 wwan，否则转发不 NAT */
			let fc = cfg('firewall');
			let wanZone = null;
			fc.foreach('firewall', 'zone', function (s) { if (t(s.name) === 'wan') wanZone = s['.name']; });
			if (wanZone != null) {
				let nets = fc.get('firewall', wanZone, 'network');
				if (nets == null) nets = [];
				if (type(nets) !== 'array') nets = [ '' + nets ];
				let has = false;
				for (let n in nets) if (t(n) === 'wwan') has = true;
				if (!has) {
					push(nets, 'wwan');
					fc.set('firewall', wanZone, 'network', nets);
					fc.commit('firewall');
					sh('/etc/init.d/firewall reload >/dev/null 2>&1');
				}
			}
			wifiReload();
			return { status: 0 };
		}
	},

