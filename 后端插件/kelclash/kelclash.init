#!/bin/sh /etc/rc.common
# /etc/init.d/kelclash —— mihomo 跑在内存（/tmp），闪存只放本脚本 + uci 文本配置。
# 开机：从镜像下载程序到 /tmp → 校验 sha256 → 生成配置 → procd 拉起。
# 断网保护：透明代理规则由 guard 实例管理，mihomo 不在/端口不通 → 立刻撤规则，全家直连。
START=99
STOP=10
USE_PROCD=1
RUN=/usr/share/kelclash/run.sh

start_service() {
	[ "$(uci -q get kelclash.main.enabled)" = "1" ] || { $RUN rules-off; return 0; }
	procd_open_instance guard
	procd_set_param command $RUN guard
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	$RUN rules-off
	$RUN core-stop
}

# 注意：故意不设 reload trigger。任何 uci commit（选节点、换用户范围、生成密钥）都会触发
# 重启，等于每次操作都断一次代理；需要重启时由后端显式 restart。
reload_service() {
	stop
	start
}
