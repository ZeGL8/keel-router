# /etc/config/kelclash —— Keel UI「代理加速」（mihomo）配置，闪存里只存这些文本
config main 'main'
	option enabled '0'
	# 订阅地址（Clash/mihomo 格式）
	option sub_url ''
	# rule=国内直连其余代理 / global=全部代理 / direct=全部直连
	# 代理内核开关（enabled）与「接管全家上网」开关（transparent）是分开的：
	# 只开内核 = 仅代理端口 7890，不动任何人的网络
	option transparent '0'
	# 手动选的节点失效时：1=自动切到最快节点（推荐）；0=保持不动
	option auto_switch '1'
	# 判断「经代理真能出去」用的探测点：必须是国内直连不通、只有走代理才能访问的地址（任一通过即算通过）
	list health_urls 'https://www.google.com/generate_204'
	list health_urls 'https://www.youtube.com/generate_204'
	option mode 'rule'
	# IPv6 流量：proxy=透明代理同时接管 IPv6 TCP（默认）；direct=IPv6 直连
	option ipv6 'proxy'
	# QUIC（UDP 443）：block=拦截，让用 HTTP/3 的 App 立刻回落到 TCP 走代理（默认）；allow=放行（UDP 不经过代理，直连）
	option quic 'block'
	# 按服务选节点：follow=跟随「代理」组；region:美国,日本=只在这些地区里选最快；node:<节点名>=固定节点
	option svc_ai 'follow'
	option svc_media 'follow'
	option svc_google 'follow'
	option svc_telegram 'follow'
	option svc_twitter 'follow'
	option svc_github 'follow'
	option version 'v1.19.31'
	option size '20317624'
	option sha256 '9061daa6a6b8cbb0491387e5de59663441b637eff0e3d295cec6949478752192'
	# 拉订阅时用的 User-Agent（不少机场只对 Clash 客户端返回节点，对其它 UA 回网页）
	option ua 'clash.meta'
	# 页面上选中的节点（开机后自动恢复）
	option node ''
	# 下载源依次尝试（{url} 替换为 GitHub 原始地址）
	list mirror 'https://ghfast.top/{url}'
	list mirror 'https://gh-proxy.com/{url}'
	list mirror 'https://ghproxy.net/{url}'
	list mirror 'https://cdn.gh-proxy.org/{url}'
	list mirror '{url}'
