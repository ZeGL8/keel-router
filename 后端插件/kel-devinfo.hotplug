#!/bin/sh
# /etc/hotplug.d/dhcp/30-kel-devinfo —— 记录设备的 DHCP 指纹（2026-09-30）
# OpenWrt 自带的 dnsmasq 脚本会把 DNSMASQ_* 环境变量（厂商类 option60、请求选项 option55）原样传给 hotplug；
# dnsmasq 只在「新租约」时触发，所以是补充信息源。只写 /tmp（内存），纯被动，不碰任何配置。
[ "$ACTION" = add ] || [ "$ACTION" = update ] || exit 0
mac=$(echo "$MACADDR" | tr 'A-F' 'a-f')
[ -n "$mac" ] || exit 0
mkdir -p /tmp/kel_dhcpfp
printf 'vendor=%s\nopts=%s\nhost=%s\n' "$DNSMASQ_VENDOR_CLASS" "$DNSMASQ_REQUESTED_OPTIONS" "$HOSTNAME" > /tmp/kel_dhcpfp/$mac
exit 0
