#!/bin/sh
# /usr/sbin/kel-watchdog —— 服务自愈看门狗（cron 每 2 分钟，2026-09-29）
#
# 只做「重启已挂掉/卡死的服务」和「撤掉失效的转发规则」这两件事，**从不修改任何配置**：
#   dnsmasq  —— procd 连崩 5 次后会放弃重拉 → 全 LAN 没 DHCP/DNS（09-27 事故形态）
#   uhttpd   —— 挂了 Keel 页面/LuCI 全打不开
#   rpcd     —— 卡死（插件死锁等）时所有页面接口超时
#   wifi     —— 配置里启用的 AP 全都没起来（hostapd 异常退出）
# 保护：
#   · 连续 2 次检测失败才动手（避免撞上用户正在保存设置导致的短暂重启）
#   · 每个服务每小时最多重启 3 次，超过只记日志不再动（防止与故障互相拉锯）
#   · 开机 5 分钟内不动作（给 netifd/wifi 完整起来的时间）
S=/tmp/kel-watchdog
mkdir -p $S
LOG() { logger -t kel-watchdog "$*"; }

# ---- Wi-Fi AP 无载波自愈 ----
# 现象（2026-10-01 回归实测）：无线中继（STA）与 AP 同射频时，wifi reload 偶发竞态——hostapd 报 ENABLED、
# 但 AP 的 netdev 一直 NO-CARRIER，2.4G Wi-Fi 搜不到、连不上，hostapd 日志刷 handle_probe_req: send failed。
# 弹跳中继（ifdown/ifup wwan）或 wifi down/up 能恢复。这里做「发现 + 修复」，每小时最多 3 次。
ap_bad() { for n in $(iw dev 2>/dev/null | awk '/Interface/{i=$2} /type AP/{print i}'); do [ "$(cat /sys/class/net/$n/carrier 2>/dev/null)" = 0 ] && return 0; done; return 1; }
wifi_heal() {
	ap_bad || return 1
	# 同一时刻只允许一个在修（后端 reload 钩子、cron 两个入口会同时撞上；多个一起弹跳中继只会互相添乱、白白耗掉每小时 3 次的额度）
	mkdir -p /tmp/kel-watchdog
	if ! mkdir /tmp/kel-watchdog/wifiheal.lock 2>/dev/null; then
		[ $(( $(date +%s) - $(cat /tmp/kel-watchdog/wifiheal.lock/ts 2>/dev/null || echo 0) )) -gt 180 ] && rm -rf /tmp/kel-watchdog/wifiheal.lock
		return 1
	fi
	date +%s > /tmp/kel-watchdog/wifiheal.lock/ts
	trap 'rm -rf /tmp/kel-watchdog/wifiheal.lock' EXIT
	mkdir -p /tmp/kel-watchdog; hf=/tmp/kel-watchdog/wifiheal.hist; now2=$(date +%s)
	: > $hf.new; for t in $(cat $hf 2>/dev/null); do [ $((now2 - t)) -lt 3600 ] && echo $t >> $hf.new; done; mv $hf.new $hf
	[ "$(wc -l < $hf)" -ge 3 ] && { logger -t kel-watchdog "Wi-Fi AP 仍无载波，但 1 小时内已修复 3 次，暂停自愈"; return 1; }
	echo $now2 >> $hf
	if [ "$(uci -q get wireless.wwan.mode)" = sta ] && [ "$(uci -q get wireless.wwan.disabled)" != 1 ]; then
		logger -t kel-watchdog "Wi-Fi AP 无载波（中继同射频时序竞态），弹跳中继"
		ifdown wwan; sleep 2; ifup wwan; sleep 20
		ap_bad || { logger -t kel-watchdog "Wi-Fi AP 已恢复"; return 0; }
	fi
	logger -t kel-watchdog "Wi-Fi AP 仍无载波，重启无线（wifi down/up）"
	/sbin/wifi down; sleep 3; /sbin/wifi up
	rm -rf /tmp/kel-watchdog/wifiheal.lock
	return 0
}
[ "$1" = wifi-heal ] && { wifi_heal; exit 0; }

up=$(cut -d. -f1 /proc/uptime)
[ "$up" -lt 300 ] && exit 0
now=$(date +%s)

# fail <name>: 记一次失败，返回 0 表示「该动手了」
fail() {
	n=$(($(cat $S/$1.strike 2>/dev/null || echo 0) + 1))
	echo $n > $S/$1.strike
	[ $n -ge 2 ] || return 1
	# 一小时内的重启次数
	: > $S/$1.hist.new
	for t in $(cat $S/$1.hist 2>/dev/null); do [ $((now - t)) -lt 3600 ] && echo $t >> $S/$1.hist.new; done
	mv $S/$1.hist.new $S/$1.hist
	if [ "$(wc -l < $S/$1.hist)" -ge 3 ]; then
		LOG "$1 仍异常，但 1 小时内已重启 3 次，暂停自愈"
		return 1
	fi
	echo $now >> $S/$1.hist
	echo 0 > $S/$1.strike
	return 0
}
ok() { echo 0 > $S/$1.strike; }

# ---- 掉电/重启留痕（2026-10-05）----
# 日志只在内存里，重启就没了，事后没法知道「为什么重启/断了多久」。这里在闪存里留很小的两个文件（只在时间可信时写，30 分钟一次，几 KB）：
#   /etc/kel_alive     最后一次确认在运行的时间（心跳）
#   /etc/kel_lastlog   那一刻的 err/crit/panic 类日志（遗言），开机后追加进 /etc/kel_boot.log
#   /etc/kel_boot.log  每次开机一行：开机时间 / 上次确认运行时间 / 间隔 / 判断（最多 30 行）
time_sane() { [ "$(date +%Y)" -ge 2026 ] && { [ -f /tmp/kel-timesync ] || [ "$(cut -d. -f1 /proc/uptime)" -gt 600 ]; }; }
# 只在完整模式里写：偶数分钟「完整」和「保险丝」两个实例同时跑，共用 /tmp/kel_boot.new，
# 一个写完删掉、另一个再「cat 不存在的文件 > 开机记录」，把整份开机记录清空了（2026-10-30 升级 1.0.4 后实际发生）
if [ "$1" != fuse ] && time_sane; then
	nowt=$(date +%s); upt=$(cut -d. -f1 /proc/uptime); boott=$((nowt - upt))
	if [ ! -f /tmp/kel-boot-logged ]; then
		prev=$(cut -d' ' -f1 /etc/kel_alive 2>/dev/null); touch /tmp/kel-boot-logged
		if [ -n "$prev" ] && [ "$prev" -gt 1700000000 ] 2>/dev/null; then
			gap=$(( (boott - prev) / 60 ))
			if [ $gap -lt 0 ]; then why="时钟异常（心跳晚于开机时间）"
			elif [ $gap -le 35 ]; then why="重启或短暂断电（最多 30 分钟内停的）"
			else why="较长时间关机/断电（约 $((gap/60)) 小时 $((gap%60)) 分钟）"; fi
			line="$(date -d @$boott '+%F %T') 开机 | 上次确认运行 $(date -d @$prev '+%F %T') | 间隔 ${gap} 分钟 | $why"
		else line="$(date -d @$boott '+%F %T') 开机 | 没有上次运行记录（首次/刚升级）"; fi
		{ tail -n 29 /etc/kel_boot.log 2>/dev/null; echo "$line"; } > /tmp/kel_boot.new; cat /tmp/kel_boot.new > /etc/kel_boot.log; rm -f /tmp/kel_boot.new
		logger -t kel-watchdog "$line"
	fi
	if [ ! -f /etc/kel_alive ] || [ $((nowt - $(cut -d' ' -f1 /etc/kel_alive 2>/dev/null || echo 0))) -ge 1800 ]; then
		echo "$nowt $upt" > /etc/kel_alive
		logread 2>/dev/null | grep -E "\.(err|crit|alert|emerg) |kernel:.*(panic|BUG:|Oops|segfault|Out of memory|oom-kill)" | grep -v "msdc_track" | tail -n 20 | cut -c1-200 > /tmp/kel_lastlog.new
		cmp -s /tmp/kel_lastlog.new /etc/kel_lastlog 2>/dev/null || cat /tmp/kel_lastlog.new > /etc/kel_lastlog
		rm -f /tmp/kel_lastlog.new
	fi
fi

# ---- 日志/临时文件容量上限（每小时一次，2026-10-05）----
# 原则：任何会增长的文件都必须有上限，且超了就自己收缩，不能靠人清理。
#   闪存（只有几百 KB 可用）：kel_alive 固定 16B、kel_lastlog ≤20 行、kel_boot.log ≤30 行、AdGuardHome.yaml 只在内容变了才写（<10KB）、
#                              rules.tgz/sub.last.gz 只在内容变了才写——全部有界，合计 <80KB，心跳每 30 分钟写 16 字节。
#   内存盘 /tmp（总量的一半是两个内核程序本体）：下面这些日志超限就只留尾部。系统日志 logd 是固定 128KB 环形缓冲，不会增长。
cap_file() {	# cap_file <文件> <最大字节> <保留行数>
	[ -f "$1" ] || return 0
	sz=$(wc -c 2>/dev/null < "$1"); [ "${sz:-0}" -gt "$2" ] || return 0
	tail -n "$3" "$1" > "$1.cap" && cat "$1.cap" > "$1"; rm -f "$1.cap"
	logger -t kel-watchdog "日志超过上限已收缩：$1（$sz 字节 → 保留最后 $3 行）"
}
if [ "$1" != fuse ]; then
	hk=/tmp/kel-watchdog/housekeep.ts; mkdir -p /tmp/kel-watchdog
	if [ ! -f $hk ] || [ $((now - $(cat $hk 2>/dev/null || echo 0))) -ge 3600 ] || [ $((now - $(cat $hk 2>/dev/null || echo 0))) -lt 0 ]; then
		echo $now > $hk
		cap_file /tmp/kelclash/core.log 2097152 1500
		cap_file /tmp/keladg/core.log 1048576 800
		cap_file /tmp/kelclash/events 16384 60
		cap_file /tmp/keladg/events 16384 60
		cap_file /tmp/kel_prof.log 262144 500
		# 性能分析开关忘了关：15 分钟后自己关掉，并清掉日志
		if [ -f /tmp/.kel_prof ] && [ -n "$(find /tmp/.kel_prof -mmin +15 2>/dev/null)" ]; then rm -f /tmp/.kel_prof /tmp/kel_prof.log; fi
		# 测试/部署遗留的临时文件：超过 1 天的清掉
		find /tmp -maxdepth 1 \( -name 'kelselftest.uc' -o -name '*.regress.bak' -o -name '.kelsub.chk' -o -name 'kelapi.new' -o -name '*.cap' \) -mtime +1 -exec rm -rf {} \; 2>/dev/null
		# 内存盘用量超过 80% 告警（正常约 50%，其中约 108MB 是两个内核程序本体）
		pct=$(df /tmp 2>/dev/null | awk 'NR==2{gsub("%","",$5); print $5}')
		[ "${pct:-0}" -ge 80 ] && logger -t kel-watchdog "内存盘 /tmp 已用 ${pct}%，请检查是否有文件异常增长（du -sk /tmp/*）"
	fi
fi

# 完整自愈每 2 分钟一次；「fuse」模式（每分钟）只跑下面两个保险丝——它们保护的是「全家断网」，等不起 2 分钟。
if [ "$1" != fuse ]; then
	# dnsmasq：DHCP 未被禁用时必须在跑
	if [ "$(uci -q get dhcp.lan.ignore)" != "1" ]; then
		if pidof dnsmasq >/dev/null; then ok dnsmasq
		elif fail dnsmasq; then LOG "dnsmasq 不在运行，重启"; /etc/init.d/dnsmasq restart; fi
	fi

	# uhttpd
	if pidof uhttpd >/dev/null; then ok uhttpd
	elif fail uhttpd; then LOG "uhttpd 不在运行，重启"; /etc/init.d/uhttpd restart; fi

	# rpcd：进程在但接口不响应也算卡死
	if ubus -t 15 call kelapi.static get_hostname >/dev/null 2>&1; then ok rpcd
	elif fail rpcd; then LOG "rpcd 无响应，重启"; /etc/init.d/rpcd restart; fi

	# dnsmasq：进程在但不应答（本机主机名的 .lan 解析，不依赖外网）也算卡死；连续 2 次（约 4 分钟）才重启
	if pidof dnsmasq >/dev/null && [ "$(uci -q get dhcp.lan.ignore)" != "1" ]; then
		hn=$(uci -q get system.@system[0].hostname); [ -n "$hn" ] || hn=OpenWrt
		if nslookup -timeout=3 -retry=1 "$hn.lan" 127.0.0.1 2>&1 | grep -q 'Address'; then ok dnsprobe
		elif fail dnsprobe; then LOG "dnsmasq 进程在但不应答，重启"; /etc/init.d/dnsmasq restart; fi
	fi

	# 上网口（非无线中继）：网线有载波、配置想联网，但接口一直起不来 → ifup（连续约 4 分钟，每小时最多 3 次）。
	# 拨号/DHCP 自己会重试，这里只兜「netifd 重试放弃了」这种卡死。
	wp=$(uci -q get network.wan.proto)
	if [ -n "$wp" ] && [ "$wp" != none ] && [ "$(uci -q get network.wan.auto)" != 0 ] && ! { [ "$(uci -q get wireless.wwan.mode)" = sta ] && [ "$(uci -q get wireless.wwan.disabled)" != 1 ]; }; then
		wdev=$(uci -q get network.wan.device); [ -n "$wdev" ] || wdev=wan
		if [ "$(cat /sys/class/net/$wdev/carrier 2>/dev/null)" = 1 ]; then
			if [ "$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.up')" = true ]; then ok wanup
			elif fail wanup; then LOG "上网口有载波但 wan 接口一直没起来，执行 ifup wan"; ifup wan; fi
		else ok wanup; fi
	fi

	# wifi：有启用的 AP 段，但系统里一个 AP 接口都没有
	want=0
	for s in $(uci -q show wireless | sed -n "s/^wireless\.\([^.]*\)\.mode='ap'$/\1/p"); do
		[ "$(uci -q get wireless.$s.disabled)" = "1" ] && continue
		r=$(uci -q get wireless.$s.device)
		[ "$(uci -q get wireless.$r.disabled)" = "1" ] && continue
		want=1
	done
	if [ $want -eq 1 ]; then
		if iw dev 2>/dev/null | grep -q "type AP"; then ok wifi
		elif fail wifi; then LOG "无线 AP 全部缺失，重新拉起无线"; /sbin/wifi up; fi
	fi
fi
# Wi-Fi AP 无载波：连续 2 次（每分钟一次）都不对才动手，避免撞上 reload 之后的短暂过渡
if ap_bad; then fail apcarrier && wifi_heal; else ok apcarrier; fi
# 代理加速的独立保险丝（不依赖 kelclash 的 guard）：
# 转发规则在，但守护进程 / 内核进程 / 监听端口任何一个不在 → 立刻撤规则恢复直连。
# 场景：guard 被 OOM 杀掉或异常退出后，规则会一直留着、把全家 TCP 送进一个已经没有的端口。
if [ -f /var/run/kelclash/redir.nft ] || nft list chain inet fw4 dstnat 2>/dev/null | grep -q kelclash; then
	gp=$(cat /tmp/kelclash/guard.pid 2>/dev/null); cp=$(cat /tmp/kelclash/pid 2>/dev/null); bad=0
	{ [ -n "$gp" ] && kill -0 "$gp" 2>/dev/null; } || bad=1
	{ [ -n "$cp" ] && kill -0 "$cp" 2>/dev/null; } || bad=1
	netstat -lnt 2>/dev/null | awk '{print $4}' | grep -qE ':7892$' || bad=1
	if [ $bad = 1 ]; then
		rm -f /var/run/kelclash/redir.nft /var/run/kelclash/quic.nft; fw4 -q reload
		LOG "代理转发规则存在但守护/内核不在，已撤销规则、恢复直连"
	fi
	# 进程都在，但设备的流量过不去（内核被卡住的连接拖垮、节点全挂且是全部代理模式……）：守护自己可能也被拖住了，
	# 这里独立地实测一次——经代理口打开国内网站。路由器直连能开、经代理打不开，连续 2 次（约 1–2 分钟）就撤规则恢复直连。
	# 不设「每小时最多几次」：这是恢复上网的保险丝，任何时候都必须能断开。
	if [ $bad = 0 ]; then
		px=$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address'); thru=0; dir=0
		for u in http://www.baidu.com/ http://www.qq.com/; do case "$(curl -s -o /dev/null -m 6 -x "http://$px:7890" -w '%{http_code}' "$u" 2>/dev/null)" in 2*|3*) thru=1; break;; esac; done
		if [ $thru = 0 ]; then for u in http://www.baidu.com/ http://www.qq.com/; do case "$(curl -s -o /dev/null -m 5 -w '%{http_code}' "$u" 2>/dev/null)" in 2*|3*) dir=1; break;; esac; done; fi
		if [ $thru = 0 ] && [ $dir = 1 ]; then
			n=$(( $(cat $S/clashpath.strike 2>/dev/null || echo 0) + 1 )); echo $n > $S/clashpath.strike
			if [ $n -ge 2 ]; then
				rm -f /var/run/kelclash/redir.nft /var/run/kelclash/quic.nft; fw4 -q reload; echo 0 > $S/clashpath.strike
				date +%s > /tmp/kelclash/fuse.ts
				printf '%s|takeover_off|%s\n' "$(date +%s)" "保险丝：国内网站经代理打不开，已撤销透明代理、恢复直连（10 分钟后再尝试接管）" >> /tmp/kelclash/events
				LOG "国内网站经代理打不开（路由器直连正常），已撤销代理转发规则、恢复直连"
			fi
		else echo 0 > $S/clashpath.strike; fi
	fi
fi
# 广告过滤的独立保险丝（同上，不依赖 keladg 的 guard）：
# DNS 转发规则在，但守护 / AdGuardHome / 监听端口任何一个不在 → 立刻撤规则，DNS 回到 dnsmasq。
# 场景：AdGuardHome 被 OOM 杀掉后，LAN 侧所有 53 端口查询会被送进一个已经没有人监听的端口 → 全家解析失败。
if [ -f /var/run/keladg/redir.nft ] || nft list chain inet fw4 dstnat 2>/dev/null | grep -q keladg; then
	gp=$(cat /tmp/keladg/guard.pid 2>/dev/null); cp=$(cat /tmp/keladg/pid 2>/dev/null); bad=0
	{ [ -n "$gp" ] && kill -0 "$gp" 2>/dev/null; } || bad=1
	{ [ -n "$cp" ] && kill -0 "$cp" 2>/dev/null; } || bad=1
	netstat -lnu 2>/dev/null | awk '{print $4}' | grep -qE ':5354$' || bad=1
	# 进程都在、端口也在，但引擎卡死不应答（守护也被卡住时没人发现）：直接问它一次
	[ $bad = 0 ] && { nslookup -port=5354 -timeout=2 -retry=1 "$(uci -q get system.@system[0].hostname).lan" 127.0.0.1 2>&1 | grep -q 'Address' || bad=1; }
	if [ $bad = 1 ]; then
		rm -f /var/run/keladg/redir.nft; fw4 -q reload
		LOG "广告过滤转发规则存在但守护/引擎不在，已撤销规则、DNS 回到 dnsmasq"
	fi
fi
exit 0
